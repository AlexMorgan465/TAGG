End Function

Private Function Headers() As Variant
    Headers = Array("FECHA", "REFERENCIA", "CANAL", "GODIGO ACTIVIDAD", "MOTIVO REASIGNADO", "COMMENTAIRE")
End Function

Private Sub EnsureHeaders(ByVal ws As Worksheet)
    Dim h As Variant, i As Long, expected As String
    h = Array("Collaborateur", "FECHA", "REFERENCIA", "CANAL", "GODIGO ACTIVIDAD", "MOTIVO REASIGNADO", "COMMENTAIRE", "DEBUT", "FIN", "DUREE")
    For i = 0 To 9
        expected = CStr(ws.Cells(1, i + 1).Value)
        If Len(expected) > 0 Then
            If StrComp(expected, h(i), vbTextCompare) <> 0 Then
                Err.Raise vbObjectError + 701, , "Entete incompatible dans " & ws.Name & ", colonne " & CStr(i + 1) & ". Aucune donnee n'a ete ecrasee."
            End If
        ElseIf Application.CountA(ws.Columns(i + 1)) > 0 Then
            Err.Raise vbObjectError + 702, , "Colonne sans entete contenant des donnees dans " & ws.Name & "."
        End If
    Next i
    For i = 0 To 9
        ws.Cells(1, i + 1).Value = h(i)
    Next i
End Sub

Private Sub EnsureMigrationBackup()
    Dim folder As String, baseName As String, extension As String
    Dim candidate As String, suffix As Long, dot As Long, detail As String
    If Len(migrationBackupPath) > 0 Then Exit Sub
    On Error GoTo Failed
    folder = ThisWorkbook.Path
    If Len(folder) = 0 Then folder = Application.DefaultFilePath
    dot = InStrRev(ThisWorkbook.Name, ".")
    If dot > 0 Then
        baseName = Left$(ThisWorkbook.Name, dot - 1)
        extension = Mid$(ThisWorkbook.Name, dot)
    Else
        baseName = ThisWorkbook.Name
        extension = ".xlsm"
    End If
    Do
        suffix = suffix + 1
        candidate = folder & Application.PathSeparator & baseName & "_avant_B_" & Format$(Now, "yyyymmdd_hhnnss") & "_" & CStr(suffix) & extension
    Loop While Len(Dir$(candidate)) > 0
    ThisWorkbook.SaveCopyAs candidate
    If Len(Dir$(candidate)) = 0 Then Err.Raise vbObjectError + 708, , "Le fichier de sauvegarde est introuvable."
    migrationBackupPath = candidate
    Exit Sub
Failed:
    detail = Err.Description
    Err.Raise vbObjectError + 709, "EnsureMigrationBackup", "Sauvegarde impossible dans " & folder & ". La migration n'a pas commence. Detail : " & detail
End Sub

Private Sub PrepareSheet(ByVal ws As Worksheet)
    Dim oldLayout As Boolean, h As Variant, i As Long, r As Long, n As Long
    Dim source As Variant, migrated() As Variant
    h = Headers()
    oldLayout = True
    For i = 0 To 5
        If StrComp(CStr(ws.Cells(1, 13 + i).Value), h(i), vbTextCompare) <> 0 Then oldLayout = False
    Next i
    If oldLayout Then
        If ws.ProtectContents Then Err.Raise vbObjectError + 710, , "La feuille " & ws.Name & " est protegee en ecriture. Aucune conversion effectuee."
        n = ws.UsedRange.Row + ws.UsedRange.Rows.Count - 1
        If n < 2 Then n = 2
        source = ws.Range("A1:R" & n).Value2
        ReDim migrated(1 To n, 1 To 10)
        migrated(1, 1) = "Collaborateur"
        For i = 0 To 5
            migrated(1, 2 + i) = h(i)
        Next i
        migrated(1, 8) = "DEBUT"
        migrated(1, 9) = "FIN"
        migrated(1, 10) = "DUREE"
        For r = 2 To n
            If Len(CStr(source(r, 13))) > 0 Then
                If Not IsDate(ws.Cells(r, 13).Value) Then Err.Raise vbObjectError + 705, , "Date invalide en M" & r & " dans " & ws.Name
                If Len(CStr(source(r, 2))) > 0 Then Err.Raise vbObjectError + 706, , "Anciennes et nouvelles donnees melangees dans " & ws.Name & ". Conversion automatique arretee."
                migrated(r, 1) = source(r, 1)
                For i = 0 To 5
                    migrated(r, 2 + i) = source(r, 13 + i)
                Next i
                migrated(r, 8) = source(r, 3)
                migrated(r, 9) = source(r, 4)
                migrated(r, 10) = source(r, 11)
            ElseIf Application.CountA(ws.Range(ws.Cells(r, 1), ws.Cells(r, 18))) > 0 Then
                Err.Raise vbObjectError + 707, , "Ligne d'un ancien format dans " & ws.Name & ". Conversion automatique arretee pour conserver ses donnees."
            End If
        Next r
        ' SaveCopyAs ne duplique aucune feuille et ne change pas la structure.
        ' Si la sauvegarde echoue, l'erreur interrompt la migration AVANT effacement.
        EnsureMigrationBackup
        ws.Range("A1:R" & n).ClearContents
        ws.Columns(3).NumberFormat = "@"
        ws.Columns(7).NumberFormat = "@"
        ws.Range("A1:J" & n).Value2 = migrated
    End If
    EnsureHeaders ws
    ws.Columns(2).NumberFormat = "dd/mm/yyyy"
    ws.Columns(3).NumberFormat = "@"
    ws.Columns(7).NumberFormat = "@"
    ws.Range("H:I").NumberFormat = "dd/mm/yyyy hh:mm:ss"
    ws.Columns(10).NumberFormat = "[h]:mm:ss"
    ws.Range("A1:J1").Font.Bold = True
    ws.Columns(1).ColumnWidth = 24
    ws.Columns(2).ColumnWidth = 12
    ws.Columns(3).ColumnWidth = 20
    ws.Columns(4).ColumnWidth = 24
    ws.Columns(5).ColumnWidth = 22
    ws.Columns(6).ColumnWidth = 26
    ws.Columns(7).ColumnWidth = 36
    ws.Range("H:I").ColumnWidth = 21
    ws.Columns(10).ColumnWidth = 12
End Sub

Private Sub HideOldFields(ByVal container As Object)
    Dim ctl As Object
    For Each ctl In container.Controls
        If TypeName(ctl) <> "CommandButton" Then ctl.Visible = False
    Next ctl
End Sub

Private Sub NewLabel(ByVal container As Object, ByVal name As String, ByVal caption As String, ByVal x As Single, ByVal y As Single, ByVal w As Single)
    Dim ctl As MSForms.Label
    Set ctl = container.Controls.Add("Forms.Label.1", name, True)
    ctl.Caption = caption
    ctl.Left = x
    ctl.Top = y
    ctl.Width = w
    ctl.Height = 12
    ctl.Font.Name = "Tahoma"
    ctl.Font.Size = 8
    ctl.BackStyle = fmBackStyleTransparent
End Sub

Private Sub PositionField(ByVal ctl As Object, ByVal x As Single, ByVal y As Single, ByVal w As Single)
    ctl.Left = x
    ctl.Top = y
    ctl.Width = w
    ctl.Height = 18
    ctl.Font.Name = "Tahoma"
    ctl.Font.Size = 8
End Sub

Private Sub SetChoices(ByVal ctl As MSForms.ComboBox, ByVal items As Variant)
    Dim item As Variant
    ctl.Clear
    ctl.Style = fmStyleDropDownList
    ctl.ListRows = 10
    For Each item In items
        ctl.AddItem CStr(item)
    Next item
    ctl.ListIndex = -1
End Sub

Private Sub HideRemovedControls(ByVal container As Object)
    Dim ctl As Object, caption As String
    For Each ctl In container.Controls
        Select Case LCase$(ctl.Name)
            Case "cmbtraitement", "optbo", "optfo", "commandbutton1"
                ctl.Visible = False
                ctl.Enabled = False
        End Select
        If TypeName(ctl) = "Label" Then
            caption = LCase$(Replace(Replace(CStr(ctl.Caption), " ", ""), "-", ""))
            If InStr(caption, "traitement") > 0 Or InStr(caption, "backoffice") > 0 Or InStr(caption, "frontoffice") > 0 Then ctl.Visible = False
        ElseIf TypeName(ctl) = "Frame" Then
            HideRemovedControls ctl
        End If
    Next ctl
End Sub

