*/

async function connectSharedFolder() {

    if (
        !(
            "showDirectoryPicker"
            in window
        )
    ) {

        showToast(
            "L'accès direct au dossier n'est pas disponible dans ce navigateur."
        );

        return;

    }


    try {

        sharedFolderHandle =
            await window.showDirectoryPicker({
                mode: "readwrite"
            });


        const button =
            document.getElementById(
                "connectFolderButton"
            );


        button.textContent =
            "✓ Dossier connecté";


        button.classList.add(
            "connected"
        );


        showToast(
            "Dossier GestionTraitement connecté."
        );

    }
    catch (error) {

        if (
            error.name !==
            "AbortError"
        ) {

            console.error(
                "Erreur dossier:",
                error
            );


            showToast(
                "Impossible d'accéder au dossier."
            );

        }

    }

}


