"use strict";


/* ============================================================
   CONFIGURATION
============================================================ */

const AGENT_ID =
    String(window.CURRENT_AGENT || "")
        .trim()
        .toUpperCase();

const STORAGE_KEY =
    "GT_AGENT_" + AGENT_ID;


/* ============================================================
   STATE LOCAL AGENT
============================================================ */

let state = {
    currentId: null,
    completed: []
};

let selectedId = null;


/* ============================================================
   CHARGEMENT LOCAL
============================================================ */

function loadLocalState() {

    try {

        const saved =
            localStorage.getItem(STORAGE_KEY);

        if (!saved) return;

        const parsed =
            JSON.parse(saved);

        state.currentId =
            parsed.currentId || null;

        state.completed =
            Array.isArray(parsed.completed)
                ? parsed.completed
                : [];

    } catch (error) {

        console.error(
            "Erreur localStorage :",
            error
        );
    }
}


function saveLocalState() {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(state)
    );
}


/* ============================================================
   DONNEES MANAGER
============================================================ */

function getAgentData() {

    if (!window.AFFECTATIONS) {

        return {
            id: AGENT_ID,
            name: AGENT_ID,
            assignments: []
        };
    }


    const agents =
        Array.isArray(window.AFFECTATIONS.agents)
            ? window.AFFECTATIONS.agents
            : [];


    const agent =
        agents.find(
            item =>
                String(item.id)
                    .toUpperCase()
                === AGENT_ID
        );


    if (!agent) {

        return {
            id: AGENT_ID,
            name: AGENT_ID,
            assignments: []
        };
    }


    return agent;
}


function getAssignments() {

    const agent =
        getAgentData();

    const completedIds =
        new Set(
            state.completed.map(
                item => item.id
            )
        );


    return (
        Array.isArray(agent.assignments)
            ? agent.assignments
            : []
    ).filter(
        item =>
            !completedIds.has(item.id)
    );
}


/* ============================================================
   NAVIGATION
============================================================ */

function showPage(pageName) {

    document
        .querySelectorAll(".page")
        .forEach(page =>
            page.classList.remove("active")
        );


    document
        .querySelectorAll(".nav-btn")
        .forEach(button =>
            button.classList.remove("active")
        );


    document
        .getElementById(pageName)
        ?.classList.add("active");


    document
        .querySelector(
            `[data-page="${pageName}"]`
        )
        ?.classList.add("active");


    const information = {

        dashboard: [
            "Tableau de bord",
            "Suivez vos lignes et vos traitements."
        ],

        pending: [
            "À traiter",
            "Consultez et traitez les lignes qui vous sont affectées."
        ],

        history: [
            "Historique",
            "Consultez les lignes que vous avez terminées."
        ]
    };


    if (information[pageName]) {

        document.getElementById(
            "pageTitle"
        ).textContent =
            information[pageName][0];


        document.getElementById(
            "pageSubtitle"
        ).textContent =
            information[pageName][1];
    }


    renderAll();
}


function initializeNavigation() {

    document
        .querySelectorAll(".nav-btn")
        .forEach(button => {

            button.addEventListener(
                "click",
                () =>
                    showPage(
                        button.dataset.page
                    )
            );
        });
}


/* ============================================================
   IDENTITE
============================================================ */

function renderIdentity() {

    const agent =
        getAgentData();

    const name =
        agent.name || AGENT_ID;


    setText(
        "sidebarAgentName",
        name
    );

    setText(
        "topAgentName",
        name
    );

    setText(
        "welcomeAgentName",
        name
    );


    setText(
        "agentAvatar",
        getInitials(name)
    );
}


/* ============================================================
   DASHBOARD
============================================================ */

function renderDashboard() {

    const assignments =
        getAssignments();


    const current =
        assignments.filter(
            item =>
                item.id ===
                state.currentId
        );


    const pending =
        assignments.filter(
            item =>
                item.id !==
                state.currentId
        );


    setText(
        "dashboardPending",
        pending.length
    );

    setText(
        "dashboardCurrent",
        current.length
    );

    setText(
        "dashboardCompleted",
        state.completed.length
    );

    setText(
        "pendingBadge",
        assignments.length
    );


    const table =
        document.getElementById(
            "dashboardPendingTable"
        );

    if (!table) return;


    table.innerHTML = "";


    if (assignments.length === 0) {

        table.innerHTML = `
            <tr>
                <td colspan="5"
                    class="empty-table">
                    Aucune ligne à traiter.
                </td>
            </tr>
        `;

        return;
    }


    assignments
        .slice(0, 5)
        .forEach(item => {

            const tr =
                document.createElement("tr");


            addCell(
                tr,
                item.line?.siret
            );

            addCell(
                tr,
                item.line?.raisonSociale
            );

            addCell(
                tr,
                item.line?.typeFacture
            );

            addCell(
                tr,
                item.line?.dateLimite
            );


            addCell(
                tr,
                item.id === state.currentId
                    ? "En cours"
                    : "À traiter"
            );


            table.appendChild(tr);
        });
}


/* ============================================================
   LISTE A TRAITER
============================================================ */

function renderPendingLines() {

    const container =
        document.getElementById(
            "pendingLines"
        );

    if (!container) return;


    container.innerHTML = "";


    const search =
        normalize(
            document.getElementById(
                "pendingSearch"
            )?.value
        );


    const assignments =
        getAssignments().filter(item => {

            const text =
                normalize(
                    `${item.line?.siret}
                     ${item.line?.raisonSociale}
                     ${item.line?.typeFacture}`
                );


            return text.includes(search);
        });


    if (assignments.length === 0) {

        container.innerHTML = `
            <div class="empty-list">
                Aucune ligne à traiter.
            </div>
        `;

        return;
    }


    assignments.forEach(item => {

        const card =
            document.createElement("button");


        card.className =
            "line-card";


        if (item.id === selectedId) {

            card.classList.add(
                "selected"
            );
        }


        if (
            item.id === state.currentId
        ) {

            card.classList.add(
                "current"
            );
        }


        card.innerHTML = `

            <div class="line-card-top">

                <strong>
                    ${escapeHtml(
                        item.line?.raisonSociale ||
                        "Sans raison sociale"
                    )}
                </strong>

                <span>
                    ${
                        item.id ===
                        state.currentId

                            ? "En cours"
                            : "À traiter"
                    }
                </span>

            </div>

            <div class="line-card-details">

                <span>
                    SIRET :
                    ${escapeHtml(
                        item.line?.siret || "—"
                    )}
                </span>

                <span>
                    ${
                        escapeHtml(
                            item.line?.typeFacture ||
                            "—"
                        )
                    }
                </span>

            </div>
        `;


        card.addEventListener(
            "click",
            () => {

                selectedId = item.id;

                renderPendingLines();

                renderSelectedLine();
            }
        );


        container.appendChild(card);
    });
}


/* ============================================================
   DETAIL
============================================================ */

function getSelectedAssignment() {

    return getAssignments().find(
        item =>
            item.id === selectedId
    );
}


function renderSelectedLine() {

    const item =
        getSelectedAssignment();


    const empty =
        document.getElementById(
            "emptySelection"
        );

    const content =
        document.getElementById(
            "selectedContent"
        );


    if (!item) {

        empty?.classList.remove(
            "hidden"
        );

        content?.classList.add(
            "hidden"
        );

        return;
    }


    empty?.classList.add(
        "hidden"
    );

    content?.classList.remove(
        "hidden"
    );


    renderInfo(
        "sourceInformation",
        [
            [
                "Fichier",
                item.source?.fileName
            ],

            [
                "CSP",
                item.source?.nomCSP
            ],

            [
                "Contrat BAD",
                item.source?.contratBAD
            ],

            [
                "IDT connexion",
                item.source?.idtConnexion
            ],

            [
                "MDP CSP",
                item.source?.mdpCSP
            ],

            [
                "N° Abonné CSP",
                item.source?.numeroAbonneCSP
            ],

            [
                "IBAN",
                item.source?.iban
            ]
        ]
    );


    renderInfo(
        "lineInformation",
        [
            [
                "SIRET",
                item.line?.siret
            ],

            [
                "Raison sociale",
                item.line?.raisonSociale
            ],

            [
                "Type facture",
                item.line?.typeFacture
            ],

            [
                "N° Abonné",
                item.line?.numeroAbonne
            ],

            [
                "Identifiant",
                item.line?.identifiant
            ],

            [
                "MDP",
                item.line?.mdp
            ],

            [
                "Contrat BAD",
                item.line?.contratBAD
            ],

            [
                "Rattachement CSP",
                item.line?.rattachement
            ],

            [
                "Date limite",
                item.line?.dateLimite
            ],

            [
                "Commentaire",
                item.line?.commentaire
            ]
        ]
    );


    const isCurrent =
        state.currentId === item.id;


    document.getElementById(
        "takeButton"
    ).disabled = isCurrent;


    document.getElementById(
        "takeButton"
    ).textContent =
        isCurrent
            ? "✓ En cours de traitement"
            : "Prendre en charge";


    setTreatmentEnabled(
        isCurrent
    );


    if (isCurrent) {

        prefillTreatment(item);
    }
}


/* ============================================================
   PRENDRE EN CHARGE
============================================================ */

function takeSelectedLine() {

    const item =
        getSelectedAssignment();


    if (!item) {

        showToast(
            "Sélectionnez une ligne."
        );

        return;
    }


    if (
        state.currentId &&
        state.currentId !== item.id
    ) {

        showToast(
            "Terminez d'abord la ligne actuellement en cours."
        );

        return;
    }


    state.currentId =
        item.id;


    saveLocalState();

    prefillTreatment(item);

    setTreatmentEnabled(true);

    renderAll();


    showToast(
        "Ligne prise en charge."
    );
}


/* ============================================================
   PREFILL
============================================================ */

function prefillTreatment(item) {

    setInput(
        "inputNumeroAbonne",
        item.line?.numeroAbonne
    );

    setInput(
        "inputIDT",
        item.line?.identifiant
    );

    setInput(
        "inputMDP",
        item.line?.mdp
    );

    setInput(
        "inputContratBAD",
        item.line?.contratBAD
    );

    setInput(
        "inputCSP",
        item.source?.nomCSP
    );
}


/* ============================================================
   TERMINER
============================================================ */

function finishTreatment() {

    const item =
        getSelectedAssignment();


    if (
        !item ||
        state.currentId !== item.id
    ) {

        showToast(
            "Aucune ligne en cours."
        );

        return;
    }


    const result = {

        ...item,

        treatment: {

            numeroAbonne:
                valueOf(
                    "inputNumeroAbonne"
                ),

            idt:
                valueOf(
                    "inputIDT"
                ),

            mdp:
                valueOf(
                    "inputMDP"
                ),

            contratBAD:
                valueOf(
                    "inputContratBAD"
                ),

            csp:
                valueOf(
                    "inputCSP"
                ),

            commentaire:
                valueOf(
                    "inputComment"
                ),

            completedAt:
                new Date()
                    .toLocaleString(
                        "fr-FR"
                    )
        }
    };


    state.completed.unshift(
        result
    );


    state.currentId = null;

    selectedId = null;


    saveLocalState();

    clearTreatment();

    renderAll();


    showToast(
        "✓ Traitement terminé."
    );
}


/* ============================================================
   ANNULER
============================================================ */

function cancelTreatment() {

    if (!state.currentId) return;


    state.currentId = null;


    saveLocalState();

    clearTreatment();

    renderAll();


    showToast(
        "Prise en charge annulée."
    );
}


/* ============================================================
   HISTORIQUE
============================================================ */

function renderHistory() {

    const table =
        document.getElementById(
            "historyTable"
        );

    if (!table) return;


    table.innerHTML = "";


    const search =
        normalize(
            document.getElementById(
                "historySearch"
            )?.value
        );


    const rows =
        state.completed.filter(item => {

            return normalize(
                `${item.line?.siret}
                 ${item.line?.raisonSociale}
                 ${item.treatment?.numeroAbonne}
                 ${item.treatment?.idt}`
            ).includes(search);
        });


    if (rows.length === 0) {

        table.innerHTML = `
            <tr>
                <td colspan="7"
                    class="empty-table">
                    Aucun traitement terminé.
                </td>
            </tr>
        `;

        return;
    }


    rows.forEach(item => {

        const tr =
            document.createElement("tr");


        addCell(
            tr,
            item.line?.siret
        );

        addCell(
            tr,
            item.line?.raisonSociale
        );

        addCell(
            tr,
            item.line?.typeFacture
        );

        addCell(
            tr,
            item.treatment?.numeroAbonne
        );

        addCell(
            tr,
            item.treatment?.idt
        );

        addCell(
            tr,
            item.treatment?.contratBAD
        );

        addCell(
            tr,
            item.treatment?.completedAt
        );


        table.appendChild(tr);
    });
}


/* ============================================================
   COPIE
============================================================ */

function copySourceInformation() {

    const item =
        getSelectedAssignment();

    if (!item) return;


    const source =
        item.source || {};


    copyText(`
Fichier : ${source.fileName || ""}
CSP : ${source.nomCSP || ""}
Contrat BAD : ${source.contratBAD || ""}
IDT connexion : ${source.idtConnexion || ""}
MDP CSP : ${source.mdpCSP || ""}
N° Abonné CSP : ${source.numeroAbonneCSP || ""}
IBAN : ${source.iban || ""}
    `.trim());
}


function copySelectedLine() {

    const item =
        getSelectedAssignment();

    if (!item) return;


    const line =
        item.line || {};


    copyText(`
SIRET : ${line.siret || ""}
Raison sociale : ${line.raisonSociale || ""}
Type : ${line.typeFacture || ""}
N° Abonné : ${line.numeroAbonne || ""}
Identifiant : ${line.identifiant || ""}
MDP : ${line.mdp || ""}
Contrat BAD : ${line.contratBAD || ""}
Date limite : ${line.dateLimite || ""}
Commentaire : ${line.commentaire || ""}
    `.trim());
}


async function copyText(text) {

    try {

        await navigator.clipboard
            .writeText(text);

        showToast("Copié.");

    } catch {

        showToast(
            "Copie impossible."
        );
    }
}


/* ============================================================
   UI HELPERS
============================================================ */

function renderInfo(
    containerId,
    values
) {

    const container =
        document.getElementById(
            containerId
        );

    if (!container) return;


    container.innerHTML = "";


    values.forEach(
        ([label, value]) => {

            const element =
                document.createElement(
                    "div"
                );

            element.className =
                "info-item";


            element.innerHTML = `

                <span class="info-label">
                    ${escapeHtml(label)}
                </span>

                <strong class="info-value">
                    ${escapeHtml(
                        value || "—"
                    )}
                </strong>
            `;


            container.appendChild(
                element
            );
        }
    );
}


function setTreatmentEnabled(
    enabled
) {

    [
        "inputNumeroAbonne",
        "inputIDT",
        "inputMDP",
        "inputContratBAD",
        "inputCSP",
        "inputComment",
        "cancelButton",
        "finishButton"
    ].forEach(id => {

        const element =
            document.getElementById(id);

        if (element) {

            element.disabled =
                !enabled;
        }
    });
}


function clearTreatment() {

    [
        "inputNumeroAbonne",
        "inputIDT",
        "inputMDP",
        "inputContratBAD",
        "inputCSP",
        "inputComment"
    ].forEach(id =>
        setInput(id, "")
    );


    setTreatmentEnabled(false);
}


function addCell(row, value) {

    const td =
        document.createElement("td");

    td.textContent =
        value || "—";

    row.appendChild(td);
}


function setText(id, value) {

    const element =
        document.getElementById(id);

    if (element) {

        element.textContent =
            value;
    }
}


function setInput(id, value) {

    const element =
        document.getElementById(id);

    if (element) {

        element.value =
            value || "";
    }
}


function valueOf(id) {

    return (
        document
            .getElementById(id)
            ?.value || ""
    ).trim();
}


function normalize(value) {

    return String(value || "")
        .normalize("NFD")
        .replace(
            /[\u0300-\u036f]/g,
            ""
        )
        .toLowerCase()
        .trim();
}


function escapeHtml(value) {

    const div =
        document.createElement("div");

    div.textContent =
        String(value || "");

    return div.innerHTML;
}


function getInitials(name) {

    const value =
        String(name || AGENT_ID);

    return value
        .substring(0, 2)
        .toUpperCase();
}


/* ============================================================
   TOAST
============================================================ */

let toastTimer;


function showToast(message) {

    const toast =
        document.getElementById("toast");

    if (!toast) return;


    toast.textContent = message;

    toast.classList.add("show");


    clearTimeout(toastTimer);


    toastTimer =
        setTimeout(
            () =>
                toast.classList.remove(
                    "show"
                ),
            3000
        );
}


/* ============================================================
   RENDER
============================================================ */

function renderAll() {

    renderIdentity();

    renderDashboard();

    renderPendingLines();

    renderSelectedLine();

    renderHistory();
}


/* ============================================================
   START
============================================================ */

function startApplication() {

    if (!AGENT_ID) {

        alert(
            "Identifiant agent absent."
        );

        return;
    }


    loadLocalState();

    initializeNavigation();


    document
        .getElementById(
            "pendingSearch"
        )
        ?.addEventListener(
            "input",
            renderPendingLines
        );


    document
        .getElementById(
            "historySearch"
        )
        ?.addEventListener(
            "input",
            renderHistory
        );


    setText(
        "currentDate",
        new Date()
            .toLocaleDateString(
                "fr-FR",
                {
                    weekday: "long",
                    day: "2-digit",
                    month: "long",
                    year: "numeric"
                }
            )
    );


    renderAll();
}


startApplication();


