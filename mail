/* ==========================================================
   PENDING LIST
========================================================== */

function renderPendingList() {

    pendingList.innerHTML = "";


    const search =
        pendingSearch.value
            .trim()
            .toLowerCase();


    const items =
        getPendingAssignments()
            .filter(item => {

                const siret =
                    item.line.siret
                        .toLowerCase();

