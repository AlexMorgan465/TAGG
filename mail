    }
];


let state =
    loadState();


function loadState() {

    const saved =
        localStorage.getItem(
            STORAGE_KEY
        );


    if (saved) {

        try {

            return JSON.parse(
                saved
            );

        }
        catch (error) {

            console.error(
                "Erreur lecture données Manager",
                error
            );

        }

    }


    return {

        agents:
            [...DEFAULT_AGENTS],

        file: null,

        source: {},

        lines: [],

        validated: false

    };

}


function saveState() {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(state)
    );

}


