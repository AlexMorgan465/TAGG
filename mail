/* ============================================================
   AJOUT AGENT
============================================================ */

function showAddAgentForm() {

    const form =
        document.getElementById(
            "addAgentForm"
        );

    if (form) {
        form.classList.remove("hidden");
    }


    const input =
        document.getElementById(
            "newAgentId"
        );

    if (input) {
        input.focus();
    }
}


function hideAddAgentForm() {

    const form =
        document.getElementById(
            "addAgentForm"
        );

    if (form) {
        form.classList.add("hidden");
    }


    const id =
        document.getElementById(
            "newAgentId"
        );

    const name =
        document.getElementById(
            "newAgentName"
        );


    if (id) {
        id.value = "";
    }

    if (name) {
        name.value = "";
    }
}


function addAgent() {

    const idInput =
        document.getElementById(
            "newAgentId"
        );

    const nameInput =
        document.getElementById(
            "newAgentName"
        );


    const id =
        String(
            idInput?.value || ""
        )
        .trim()
        .toUpperCase()
        .replace(/\s+/g, "");


    const name =
        String(
            nameInput?.value || ""
        ).trim();


    if (!id) {

        showToast(
            "Saisissez l'identifiant."
        );

        return;
    }


    if (
        state.agents.some(
            agent =>
                agent.id === id
        )
    ) {

        showToast(
            "Cet agent existe déjà."
        );

        return;
    }


    state.agents.push({

        id,

        name:
            name || id
    });


    state.validated = false;


    saveState();

    hideAddAgentForm();

    renderAll();


    showToast(
        "Agent ajouté."
    );
}


/* ============================================================
   SUPPRESSION AGENT
============================================================ */

function removeAgent(agentId) {

    const agent =
        state.agents.find(
            item =>
                item.id === agentId
        );

    if (!agent) {
        return;
    }


    const assigned =
        state.lines.filter(
            line =>
                line.assignedTo ===
                agentId
        );


    if (assigned.length > 0) {

        const confirmed =
            confirm(
                `${agent.name} possède ${assigned.length} ligne(s).\n\n` +
                "Ces lignes redeviendront non affectées.\n\n" +
                "Continuer ?"
            );


        if (!confirmed) {
            return;
        }
    }


    state.lines.forEach(line => {

        if (
            line.assignedTo ===
            agentId
        ) {

            line.assignedTo = null;
        }
    });


    state.agents =
        state.agents.filter(
            agent =>
                agent.id !== agentId
        );


    state.validated = false;


    saveState();

    renderAll();


    showToast(
        "Agent supprimé."
    );
}


/* ============================================================
   DRAG & DROP EXCEL
============================================================ */

function initializeDragAndDrop() {

    const dropZone =
        document.getElementById(
            "dropZone"
        );

    if (!dropZone) {
        return;
    }


    [
        "dragenter",
        "dragover"
    ].forEach(eventName => {

        dropZone.addEventListener(
            eventName,
            event => {

                event.preventDefault();

                dropZone.classList.add(
                    "dragging"
                );
            }
        );
    });


    [
        "dragleave",
        "drop"
    ].forEach(eventName => {

        dropZone.addEventListener(
            eventName,
            event => {

                event.preventDefault();

                dropZone.classList.remove(
                    "dragging"
                );
            }
        );
    });


    dropZone.addEventListener(
        "drop",
        event => {

            const file =
                event.dataTransfer
                    .files[0];

            if (file) {
                importExcelFile(file);
            }
        }
    );
}


/* ============================================================
   HELPERS
============================================================ */

function sanitizeFileName(value) {

    return String(value)
        .replace(
            /[<>:"/\\|?*]/g,
            "_"
        )
        .trim();
}


function getInitials(name) {

    const words =
        String(name || "")
            .trim()
            .split(/\s+/)
            .filter(Boolean);


    if (words.length === 0) {
        return "--";
    }


    if (words.length === 1) {

        return words[0]
            .substring(0, 2)
            .toUpperCase();
    }


    return (
        words[0][0] +
        words[
            words.length - 1
        ][0]
    ).toUpperCase();
}


