/* ============================================================
   STATE
============================================================ */

function createDefaultState() {

    return {

        source: {

            fileName: "",

            nomCSP: "",

            contratBAD: "",

            idtConnexion: "",

            mdpCSP: "",

            numeroAbonneCSP: "",

            iban: "",

            importedAt: ""

        },

        lines: [],

        agents:
            JSON.parse(
                JSON.stringify(
                    DEFAULT_AGENTS
                )
            ),

        validated: false

    };

}


function loadState() {

    const saved =
        localStorage.getItem(
            STORAGE_KEY
        );


    if (!saved) {

        return createDefaultState();

    }


    try {

        const parsed =
            JSON.parse(
                saved
            );


        if (
            !Array.isArray(
                parsed.agents
            )
        ) {

            parsed.agents =
                JSON.parse(
                    JSON.stringify(
                        DEFAULT_AGENTS
                    )
                );

        }


        if (
            !Array.isArray(
                parsed.lines
            )
        ) {

            parsed.lines =
                [];

        }


        return parsed;

    }
    catch (error) {

        console.error(
            "Erreur chargement état Manager:",
            error
        );


        return createDefaultState();

    }

}


let state =
    loadState();


function saveState() {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(
            state
        )
    );

}


