    --primary-dark: #1d4ed8;

    --background: #f5f7fb;
    --sidebar: #111827;

    --text: #1f2937;
    --muted: #6b7280;

    --border: #e5e7eb;

    --success: #16a34a;
    --danger: #dc2626;

    --white: #ffffff;
}

body {
    margin: 0;

    font-family:
        Inter,
