============================================================ */

function assignAllToSelectedAgent() {

    const select =
        document.getElementById(
            "bulkAgentSelect"
        );


    if (!select || !select.value) {

        showToast(
            "Sélectionnez un agent."
        );

        return;
    }


    const selected =
        state.lines.filter(
            line => line.selected
        );


    if (selected.length === 0) {

        showToast(
            "Sélectionnez au moins une ligne."
        );

        return;
    }


    selected.forEach(line => {

        line.assignedTo =
            select.value;

        line.selected = false;
    });


    state.validated = false;


    const selectAll =
        document.getElementById(
            "selectAllLines"
        );

    if (selectAll) {
        selectAll.checked = false;
    }


    saveState();

    renderAll();


    showToast(
        `${selected.length} ligne(s) affectée(s).`
    );
}


/* ============================================================
   VALIDATION ET ECRITURE
============================================================ */

async function validateAssignments() {

    if (state.lines.length === 0) {

        showToast(
            "Aucune ligne à envoyer."
        );

        return;
    }


    const unassigned =
        state.lines.filter(
            line => !line.assignedTo
        );


    if (unassigned.length > 0) {

        showToast(
            `${unassigned.length} ligne(s) restent à affecter.`
        );

        return;
    }


    if (!sharedFolderHandle) {

        showToast(
            "Connectez d'abord le dossier PeopleList."
        );

        return;
    }


    const button =
        document.getElementById(
            "validateAssignmentsButton"
        );


    if (button) {

        button.disabled = true;

        button.textContent =
            "Envoi en cours...";
    }


    try {

        await writeAgentFiles();


        state.validated = true;

        saveState();


        showToast(
            "✓ Affectations envoyées aux agents."
        );


        renderDashboard();

    } catch (error) {

        console.error(
            "Erreur validation :",
            error
        );


        showToast(
            "Erreur : " +
            (
                error.message ||
                error.name
            )
        );

    } finally {

        if (button) {

            button.disabled = false;

            button.textContent =
                "✓ Valider les affectations";
        }
    }
}


/* ============================================================
   CREATION DES FICHIERS AGENTS
============================================================ */

async function writeAgentFiles() {

    if (!sharedFolderHandle) {

        throw new Error(
            "Dossier PeopleList non connecté."
        );
    }


    /*
        PeopleList/data
    */

    const dataFolder =
        await sharedFolderHandle
            .getDirectoryHandle(
                "data",
                {
                    create: true
                }
            );


    /*
        PeopleList/data/agents
    */

    const agentsFolder =
        await dataFolder
            .getDirectoryHandle(
                "agents",
                {
                    create: true
                }
            );


    /*
        Un fichier par agent.
    */

    for (
        const agent of state.agents
    ) {

        const assignedLines =
            state.lines.filter(
                item =>
                    item.assignedTo ===
                    agent.id
            );


        const assignments =
            assignedLines.map(item => ({

                id: item.id,

                assignedAt:
                    new Date()
                        .toLocaleString(
                            "fr-FR"
                        ),

                source: {

                    fileName:
                        state.source.fileName,

                    nomCSP:
                        state.source.nomCSP,

                    contratBAD:
                        state.source.contratBAD,

                    idtConnexion:
                        state.source.idtConnexion,

                    mdpCSP:
                        state.source.mdpCSP,

                    numeroAbonneCSP:
                        state.source.numeroAbonneCSP,

                    iban:
                        state.source.iban
                },

                line: {
                    ...item.line
                },

                status: "pending"
            }));


        const agentData = {

            agent: agent.id,

            agentName: agent.name,

            updatedAt:
                new Date()
                    .toLocaleString(
                        "fr-FR"
                    ),

            assignments
        };


        /*
            IMPORTANT

            Agent.html pourra charger directement
            ce fichier JS.

            Exemple :

            window.AGENT_DATA = {...};
        */

        const content =
            "window.AGENT_DATA = " +
            JSON.stringify(
                agentData,
                null,
                2
            ) +
            ";\n";


        const fileName =
            sanitizeFileName(
                agent.id
            ) +
            ".js";


        const fileHandle =
            await agentsFolder
                .getFileHandle(
                    fileName,
                    {
                        create: true
                    }
                );


        const writable =
            await fileHandle
                .createWritable();


        await writable.write(
            content
        );


        await writable.close();


        console.log(
            "Fichier agent écrit :",
            fileName,
            assignments.length,
            "ligne(s)"
        );
    }
}


