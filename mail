        }

    }

];


/* =========================================================
   STORAGE
========================================================= */

let pendingLines =
    JSON.parse(
        localStorage.getItem("pendingLines")
    );


let completedLines =
    JSON.parse(
        localStorage.getItem("completedLines")
    ) || [];


let currentTreatment =
    JSON.parse(
        localStorage.getItem("currentTreatment")
    ) || null;


if (!pendingLines) {

    pendingLines = defaultPendingLines;

    saveData();

}


/* Selected but NOT taken yet */

let selectedLineId = null;


/* =========================================================
   SAVE
========================================================= */

function saveData() {

    localStorage.setItem(
        "pendingLines",
        JSON.stringify(pendingLines)
    );


    localStorage.setItem(
        "completedLines",
        JSON.stringify(completedLines)
    );


    localStorage.setItem(
        "currentTreatment",
        JSON.stringify(currentTreatment)
    );

}


/* =========================================================
   NAVIGATION
========================================================= */

const navItems =
    document.querySelectorAll(".nav-item");


navItems.forEach(button => {

    button.addEventListener("click", () => {

        const page =
            button.dataset.page;

        showPage(page);

    });

});


function showPage(pageName) {

    document
        .querySelectorAll(".page")
        .forEach(page => {

            page.classList.remove("active");

        });


    document
        .querySelectorAll(".nav-item")
        .forEach(item => {

            item.classList.remove("active");

        });


    document
        .getElementById(pageName)
        .classList.add("active");


    document
        .querySelector(
            `[data-page="${pageName}"]`
        )
        .classList.add("active");


    updatePageTitle(pageName);

}


function updatePageTitle(page) {

    const title =
        document.getElementById("pageTitle");

    const subtitle =
        document.getElementById("pageSubtitle");


    if (page === "dashboard") {

        title.textContent =
            "Tableau de bord";

        subtitle.textContent =
            "Vue générale de votre activité";

    }


    if (page === "traitement") {

        title.textContent =
            "Traitement";

        subtitle.textContent =
            "Sélection et traitement des lignes";

    }


    if (page === "historique") {

        title.textContent =
            "Historique";

        subtitle.textContent =
            "Consultez les lignes déjà traitées";

    }

}


function openTreatmentPage() {

    showPage("traitement");

}


/* =========================================================
   DASHBOARD
========================================================= */

function renderDashboard() {

    document
        .getElementById("pendingCount")
        .textContent =
        pendingLines.length;


    document
        .getElementById("completedCount")
        .textContent =
        completedLines.length;


    document
        .getElementById("currentCount")
        .textContent =
        currentTreatment ? 1 : 0;


    document
        .getElementById("sidebarPendingCount")
        .textContent =
        pendingLines.length;


    const table =
        document.getElementById(
            "dashboardPendingTable"
        );


    table.innerHTML = "";


    pendingLines.forEach(line => {

        table.innerHTML += `

            <tr>

                <td>${line.siret}</td>

                <td>
                    ${line.raisonSociale}
                </td>

                <td>
                    ${line.typeFacture}
                </td>

                <td>
                    ${line.dateLimite}
                </td>

                <td>
                    <span class="status pending">
                        À traiter
                    </span>
                </td>

            </tr>

        `;

    });


    if (pendingLines.length === 0) {

        table.innerHTML = `

            <tr>

                <td colspan="5"
                    style="
                        text-align:center;
                        color:#9ca3af;
                        padding:30px;
                    ">

                    Aucune ligne à traiter.

                </td>

            </tr>

        `;

    }

}


/* =========================================================
   PENDING LIST
========================================================= */

function renderPendingLines() {

    const container =
        document.getElementById(
            "pendingList"
        );


    container.innerHTML = "";


    document
        .getElementById("pendingLabel")
        .textContent =
        `${pendingLines.length} ligne${pendingLines.length > 1 ? "s" : ""}`;


    pendingLines.forEach(line => {

        const item =
            document.createElement("div");


        item.className =
            "pending-item";


        if (
            selectedLineId === line.id
        ) {

            item.classList.add(
                "selected"
            );

        }


        item.innerHTML = `

            <div class="pending-top">

                <span class="pending-company">
                    ${line.raisonSociale}
                </span>

                <span class="status pending">
                    À traiter
                </span>

            </div>


            <div class="pending-siret">

                SIRET :
                ${line.siret}

            </div>


            <div class="pending-bottom">

                <span>
                    Facture :
                    ${line.typeFacture}
                </span>

                <span>
                    ${line.dateLimite}
                </span>

            </div>

        `;


        item.addEventListener(
            "click",
            () => selectLine(line.id)
        );


        container.appendChild(item);

    });


    if (pendingLines.length === 0) {

        container.innerHTML = `

            <div style="
                text-align:center;
                padding:40px;
                color:#9ca3af;
            ">

                ✓ Toutes les lignes
                ont été traitées.

            </div>

        `;

    }

}


/* =========================================================
   SELECT LINE
========================================================= */

function selectLine(id) {

    /*
        Prevent selecting another line
        while a treatment is active.
    */

    if (currentTreatment) {

        showToast(
            "Terminez ou annulez d'abord le traitement en cours."
        );

        return;

    }


    selectedLineId = id;


    renderPendingLines();


    const line =
        pendingLines.find(
            item => item.id === id
        );


    if (!line) return;


    displayLineDetails(line);

}


/* =========================================================
   DISPLAY DETAILS
========================================================= */

function displayLineDetails(line) {

    document
        .getElementById("noSelection")
        .classList.add("hidden");


    document
        .getElementById(
            "detailsContainer"
        )
        .classList.remove("hidden");


    const source =
        document.getElementById(
            "sourceFields"
        );


    source.innerHTML = "";


    addInfoRow(
        source,
        "Nom CSP",
        line.source.nomCSP
    );

    addInfoRow(
        source,
        "Contrat BAD",
        line.source.contratBAD
    );

    addInfoRow(
        source,
        "IDT Connexion",
        line.source.idtConnexion
    );

    addInfoRow(
        source,
        "N° Abonné CSP",
        line.source.numeroAbonneCSP
    );

    addInfoRow(
        source,
        "IBAN Prélèvement",
        line.source.ibanPrelevement
    );

    addInfoRow(
        source,
        "MDP CSP",
        line.source.mdpCSP
    );


    /* LINE INFO */

    const info =
        document.getElementById(
            "lineFields"
        );


    info.innerHTML = "";


    addInfoRow(
        info,
        "Raison Sociale",
        line.raisonSociale
    );

    addInfoRow(
        info,
        "SIRET",
        line.siret
    );

    addInfoRow(
        info,
        "Type Facture",
        line.typeFacture
    );

    addInfoRow(
        info,
        "Date Limite",
        line.dateLimite
    );

}


/* =========================================================
   INFO ROW + COPY
========================================================= */

function addInfoRow(
    container,
    label,
    value
) {

    const row =
        document.createElement("div");


    row.className =
        "info-row";


    const labelElement =
        document.createElement("label");


    labelElement.textContent =
        label;


    const valueElement =
        document.createElement("div");


    valueElement.className =
        "info-value";


    valueElement.textContent =
        value || "-";


    const copyButton =
        document.createElement("button");


    copyButton.className =
        "copy-btn";


    copyButton.textContent =
        "Copier";


    copyButton.addEventListener(
        "click",
        () => copyText(value)
    );


    row.appendChild(
        labelElement
    );

    row.appendChild(
        valueElement
    );

    row.appendChild(
        copyButton
    );


    container.appendChild(row);

}


/* =========================================================
   COPY
========================================================= */

function copyText(text) {

    navigator.clipboard
        .writeText(text || "")
        .then(() => {

            showToast(
                "Information copiée."
            );

        })
        .catch(() => {

            showToast(
                "Impossible de copier."
            );

        });

}


/* =========================================================
   TAKE LINE
========================================================= */

function takeSelectedLine() {

    if (!selectedLineId) {

        showToast(
            "Sélectionnez une ligne."
        );

        return;

    }


    const line =
        pendingLines.find(
            item =>
                item.id ===
                selectedLineId
        );


    if (!line) return;


    currentTreatment = line;


    saveData();


    enableTreatmentInputs();


    /*
        We can automatically prefill
        some information if wanted.
    */

    document
        .getElementById(
            "inputContrat"
        )
        .value =
        line.source.contratBAD || "";


    document
        .getElementById(
            "inputCSP"
        )
        .value =
        line.source.nomCSP || "";


    document
        .getElementById(
            "takeBtn"
        )
        .disabled = true;


    renderDashboard();


    showToast(
        "Ligne prise en charge."
    );

}


/* =========================================================
   INPUT STATE
========================================================= */

function enableTreatmentInputs() {

    const ids = [

        "inputAbonne",
        "inputIDT",
        "inputMDP",
        "inputContrat",
        "inputCSP"

    ];


    ids.forEach(id => {

        document
            .getElementById(id)
            .disabled = false;

    });


    document
        .getElementById(
            "finishBtn"
        )
        .disabled = false;


    document
        .getElementById(
            "cancelBtn"
        )
        .disabled = false;

}


function disableTreatmentInputs() {

    const ids = [

        "inputAbonne",
        "inputIDT",
        "inputMDP",
        "inputContrat",
        "inputCSP"

    ];


    ids.forEach(id => {

        const input =
            document.getElementById(id);

        input.disabled = true;

        input.value = "";

    });


    document
        .getElementById(
            "finishBtn"
        )
        .disabled = true;


    document
        .getElementById(
            "cancelBtn"
        )
        .disabled = true;

}


/* =========================================================
   CANCEL
========================================================= */

function cancelTreatment() {

    if (!currentTreatment) return;


    currentTreatment = null;


    saveData();


    disableTreatmentInputs();


    document
        .getElementById(
            "takeBtn"
        )
        .disabled = false;


    renderDashboard();


    showToast(
        "Prise en charge annulée."
    );

}


/* =========================================================
   FINISH
========================================================= */

function finishTreatment() {

    if (!currentTreatment) {

        showToast(
            "Aucun traitement en cours."
        );

        return;

    }


    const abonne =
        document
            .getElementById(
                "inputAbonne"
            )
            .value
            .trim();


    const idt =
        document
            .getElementById(
                "inputIDT"
            )
            .value
            .trim();


    const mdp =
        document
            .getElementById(
                "inputMDP"
            )
            .value
            .trim();


    const contrat =
        document
            .getElementById(
                "inputContrat"
            )
            .value
            .trim();


    const csp =
        document
            .getElementById(
                "inputCSP"
            )
            .value
            .trim();


    /*
        For V1 we require every field.
    */

    if (
        !abonne ||
        !idt ||
        !mdp ||
        !contrat ||
        !csp
    ) {

        showToast(
            "Veuillez compléter toutes les saisies."
        );

        return;

    }


    const completed = {

        ...currentTreatment,

        traitement: {

            numeroAbonne: abonne,

            idt: idt,

            mdp: mdp,

            contratBAD: contrat,

            csp: csp

        },

        agent:
            "HAMDANMO",

        completedAt:
            new Date()
                .toLocaleString("fr-FR")

    };


    completedLines.unshift(
        completed
    );


    /*
        Remove from pending.
    */

    pendingLines =
        pendingLines.filter(
            line =>
                line.id !==
                currentTreatment.id
        );


    currentTreatment = null;

    selectedLineId = null;


    saveData();


    disableTreatmentInputs();


    resetDetails();


    renderEverything();


    showToast(
        "✓ Ligne traitée avec succès."
    );

}


/* =========================================================
   RESET DETAILS
========================================================= */

function resetDetails() {

    document
        .getElementById(
            "detailsContainer"
        )
        .classList.add("hidden");


    document
        .getElementById(
            "noSelection"
        )
        .classList.remove("hidden");


    document
        .getElementById(
            "takeBtn"
        )
        .disabled = false;

}


/* =========================================================
   HISTORY
========================================================= */

function renderHistory() {

    const table =
        document.getElementById(
            "historyTable"
        );


    const search =
        document.getElementById(
            "historySearch"
        )
        .value
        .toLowerCase();


    table.innerHTML = "";


    const filtered =
        completedLines.filter(
            line => {

                return (

                    line.siret
                        .toLowerCase()
                        .includes(search)

                    ||

                    line.raisonSociale
                        .toLowerCase()
                        .includes(search)

                    ||

                    line.agent
                        .toLowerCase()
                        .includes(search)

                );

            }
        );


    filtered.forEach(line => {

        table.innerHTML += `

            <tr>

                <td>
                    ${line.siret}
                </td>

                <td>
                    ${line.raisonSociale}
                </td>

                <td>
                    ${line.typeFacture}
                </td>

                <td>
                    ${line.traitement.numeroAbonne}
                </td>

                <td>
                    ${line.traitement.idt}
                </td>

                <td>
                    ${line.traitement.csp}
                </td>

                <td>
                    ${line.agent}
                </td>

                <td>
                    ${line.completedAt}
                </td>

            </tr>

        `;

    });


    if (filtered.length === 0) {

        table.innerHTML = `

            <tr>

                <td colspan="8"
                    style="
                        text-align:center;
                        padding:35px;
                        color:#9ca3af;
                    ">

                    Aucun traitement trouvé.

                </td>

            </tr>

        `;

    }

}


/* =========================================================
   TOAST
========================================================= */

let toastTimer;


function showToast(message) {

    const toast =
        document.getElementById(
            "toast"
        );


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    clearTimeout(
        toastTimer
    );


    toastTimer =
        setTimeout(() => {

            toast.classList.remove(
                "show"
            );

        }, 2500);

}


/* =========================================================
   DATE
========================================================= */

function displayCurrentDate() {

    const date =
        new Date();


    document
        .getElementById(
            "currentDate"
        )
        .textContent =
        date.toLocaleDateString(
            "fr-FR",
            {
                weekday: "long",
                day: "2-digit",
                month: "long",
                year: "numeric"
            }
        );

}


/* =========================================================
   RESTORE ACTIVE TREATMENT
========================================================= */

function restoreTreatment() {

    if (!currentTreatment)
        return;


    selectedLineId =
        currentTreatment.id;


    displayLineDetails(
        currentTreatment
    );


    enableTreatmentInputs();


    document
        .getElementById(
            "takeBtn"
        )
        .disabled = true;

}


/* =========================================================
   RENDER EVERYTHING
========================================================= */

function renderEverything() {

    renderDashboard();

    renderPendingLines();

    renderHistory();

}


/* =========================================================
   START APPLICATION
========================================================= */

displayCurrentDate();

renderEverything();

restoreTreatment();

