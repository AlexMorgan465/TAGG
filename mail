/* ==========================================================
   INFORMATION CARDS
========================================================== */

function renderInformation(
    container,
    information
) {

    container.innerHTML =
        "";


    information.forEach(
        ([label, value]) => {

            const item =
                document.createElement(
                    "div"
                );


            item.className =
                "info-item";


            const labelElement =
                document.createElement(
                    "span"
                );


            labelElement.className =
                "info-label";


            labelElement.textContent =
                label;


            const valueElement =
                document.createElement(
                    "span"
                );


            valueElement.className =
                "info-value";


            valueElement.textContent =
                value || "—";


            const copyButton =
                document.createElement(
                    "button"
                );


            copyButton.className =
                "copy-button";


            copyButton.textContent =
                "⧉";


            copyButton.addEventListener(
                "click",
                event => {

                    event.stopPropagation();

                    copyValue(
                        value || ""
                    );

                }
            );


            item.append(
                labelElement,
                valueElement,
                copyButton
            );


            container.appendChild(
                item
            );

        }
    );

}


/* ==========================================================
   TAKE
========================================================== */

function takeSelectedLine() {

    if (!selectedLineId) {
        return;
    }


    if (
        state.activeTreatmentId &&
        state.activeTreatmentId !==
            selectedLineId
    ) {

        showToast(
            "Une autre ligne est déjà en cours."
        );

        return;

    }


    const item =
        state.assignments.find(
            row =>
                row.id ===
                selectedLineId
        );


    if (!item) {
        return;
    }


    item.status =
        "processing";


    state.activeTreatmentId =
        item.id;


    /*
        Prefill with any existing line-level values first.
        Otherwise use CSP source values.
    */

    document.getElementById(
        "subscriberNumber"
    ).value =
        item.line.numeroAbonne ||
        item.source?.numeroAbonneCSP ||
        "";


    document.getElementById(
        "idt"
    ).value =
        item.line.identifiant ||
        item.source?.idtConnexion ||
        "";


    document.getElementById(
        "password"
    ).value =
        item.line.mdp ||
        item.source?.mdpCSP ||
        "";


    document.getElementById(
        "badContract"
    ).value =
        item.line.contratBAD ||
        item.source?.contratBAD ||
        "";


    document.getElementById(
        "csp"
    ).value =
        item.source?.nomCSP ||
        "";


    saveState();

    renderAll();

    displaySelectedLine(
        item
    );


    showToast(
        "Ligne prise en charge."
    );

}


/* ==========================================================
   CANCEL
========================================================== */

function cancelTreatment() {

    const item =
        state.assignments.find(
            row =>
                row.id ===
                state.activeTreatmentId
        );


    if (!item) {
        return;
    }


    item.status =
        "pending";


    state.activeTreatmentId =
        null;


    clearForm();

    saveState();

    renderAll();

    displaySelectedLine(
        item
    );


    showToast(
        "Traitement annulé."
    );

}


/* ==========================================================
   COMPLETE
========================================================== */

function completeTreatment() {

    if (
        !state.activeTreatmentId
    ) {

        return;

    }


    const treatment = {

        numeroAbonne:
            getValue(
                "subscriberNumber"
            ),

        idt:
            getValue(
                "idt"
            ),

        mdp:
            getValue(
                "password"
            ),

        contratBAD:
            getValue(
                "badContract"
            ),

        csp:
            getValue(
                "csp"
            ),

        commentaire:
            getValue(
                "comment"
            )

    };


    if (
        !treatment.numeroAbonne ||
        !treatment.idt ||
        !treatment.mdp ||
        !treatment.contratBAD ||
        !treatment.csp
    ) {

        showToast(
            "Complétez tous les champs obligatoires."
        );

        return;

    }


    const index =
        state.assignments.findIndex(
            row =>
                row.id ===
                state.activeTreatmentId
        );


    if (
        index === -1
    ) {
        return;
    }


    const item =
        state.assignments[index];


    state.completed.unshift({

        ...item,

        status:
            "completed",

        treatment,

        completedBy:
            AGENT.name,

        completedAt:
            new Date()
                .toLocaleString(
                    "fr-FR"
                )

    });


    state.assignments.splice(
        index,
        1
    );


    state.activeTreatmentId =
        null;


    selectedLineId =
        null;


    saveState();

    clearForm();

    closeDetails();

    renderAll();


    showToast(
        "Traitement terminé."
    );

}


