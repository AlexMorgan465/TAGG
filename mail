<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestion Traitement - Manager</title>

    <link rel="stylesheet" href="css/manager.css">
</head>

<body>

<div class="app">

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-logo">
                GT
            </div>

            <div class="brand-text">
                <strong>Gestion Traitement</strong>
                <span>Espace Manager</span>
            </div>

        </div>


        <nav class="navigation">

            <button
                class="nav-btn active"
                data-page="dashboard"
            >
                <span class="nav-icon">▦</span>
                <span>Tableau de bord</span>
            </button>


            <button
                class="nav-btn"
                data-page="import"
            >
                <span class="nav-icon">⇧</span>
                <span>Import Excel</span>
            </button>


            <button
                class="nav-btn"
                data-page="assignments"
            >
                <span class="nav-icon">⇄</span>
                <span>Affectations</span>

                <span
                    id="navUnassignedCount"
                    class="nav-count"
                >
                    0
                </span>
            </button>


            <button
                class="nav-btn"
                data-page="agents"
            >
                <span class="nav-icon">♙</span>
                <span>Agents</span>
            </button>

        </nav>


        <div class="manager-profile">

            <div class="avatar">
                MG
            </div>

            <div class="manager-profile-text">
                <strong>Manager</strong>
                <span>Gestionnaire</span>
            </div>

        </div>

    </aside>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="main">

        <!-- =================================================
             TOPBAR
        ================================================== -->

        <header class="topbar">

            <div>

                <h1 id="pageTitle">
                    Tableau de bord
                </h1>

                <p id="pageSubtitle">
                    Importez et répartissez les lignes entre les agents.
                </p>

            </div>


            <div class="topbar-actions">

                <div
                    id="currentDate"
                    class="date-box"
                >
                </div>


                <button
                    id="connectFolderButton"
                    class="secondary-btn"
                    onclick="connectSharedFolder()"
                >
                    📁 Connecter le dossier
                </button>


                <button
                    class="primary-btn"
                    onclick="openImportDialog()"
                >
                    + Importer Excel
                </button>

            </div>

        </header>


        <!-- =================================================
             DASHBOARD
        ================================================== -->

        <section
            id="dashboard"
            class="page active"
        >

            <div class="welcome">

                <div>

                    <span class="eyebrow">
                        ESPACE MANAGER
                    </span>

                    <h2>
                        Gestion des affectations
                    </h2>

                    <p>
                        Importez le fichier source, contrôlez les données
                        puis affectez les lignes aux agents.
                    </p>

                </div>


                <button
                    class="primary-btn"
                    onclick="openImportDialog()"
                >
                    + Nouvel import
                </button>

            </div>


            <!-- STATS -->

            <div class="stats">

                <article class="stat-card">

                    <div class="stat-icon">
                        ≡
                    </div>

                    <div>
                        <span>Lignes importées</span>
                        <strong id="totalLinesCount">0</strong>
                    </div>

                </article>


                <article class="stat-card">

                    <div class="stat-icon warning-icon">
                        !
                    </div>

                    <div>
                        <span>Non affectées</span>
                        <strong id="unassignedCount">0</strong>
                    </div>

                </article>


                <article class="stat-card">

                    <div class="stat-icon success-icon">
                        ✓
                    </div>

                    <div>
                        <span>Affectées</span>
                        <strong id="assignedCount">0</strong>
                    </div>

                </article>


                <article class="stat-card">

                    <div class="stat-icon active-icon">
                        ♙
                    </div>

                    <div>
                        <span>Agents</span>
                        <strong id="agentsCount">0</strong>
                    </div>

                </article>

            </div>


            <!-- LAST IMPORT -->

            <div class="card">

                <div class="card-header">

                    <div>
                        <h3>Dernier import</h3>
                        <p>
                            Informations du fichier actuellement chargé.
                        </p>
                    </div>

                </div>


                <div
                    id="dashboardImportInformation"
                    class="info-grid"
                >
                </div>

            </div>


            <!-- DISTRIBUTION -->

            <div class="card">

                <div class="card-header">

                    <div>
                        <h3>Répartition par agent</h3>
                        <p>
                            Nombre de lignes actuellement affectées.
                        </p>
                    </div>

                </div>


                <div
                    id="agentDistribution"
                    class="agent-distribution"
                >
                </div>

            </div>

        </section>


        <!-- =================================================
             IMPORT
        ================================================== -->

        <section
            id="import"
            class="page"
        >

            <div class="card">

                <div class="card-header">

                    <div>
                        <h3>Importer un fichier Excel</h3>
                        <p>
                            Sélectionnez le fichier source contenant les
                            informations CSP et les lignes clients.
                        </p>
                    </div>

                </div>


                <div
                    id="dropZone"
                    class="import-zone"
                    onclick="openImportDialog()"
                >

                    <div class="import-icon">
                        ⇧
                    </div>

                    <h3>
                        Sélectionner un fichier Excel
                    </h3>

                    <p>
                        Formats acceptés : XLSX, XLS, XLSM
                    </p>

                    <button
                        class="primary-btn"
                        type="button"
                    >
                        Parcourir
                    </button>

                </div>


                <input
                    id="excelInput"
                    type="file"
                    accept=".xlsx,.xls,.xlsm"
                    hidden
                >

            </div>


            <!-- IMPORT RESULT -->

            <div
                id="importResult"
                class="hidden"
            >

                <div class="card">

                    <div class="card-header">

                        <div>
                            <h3>Fichier importé</h3>
                            <p id="importFileName">—</p>
                        </div>

                        <span class="status success-status">
                            Importé
                        </span>

                    </div>


                    <div
                        id="sourceInformation"
                        class="info-grid"
                    >
                    </div>

                </div>


                <div class="card">

                    <div class="card-header">

                        <div>
                            <h3>Lignes détectées</h3>
                            <p>
                                Vérifiez les données avant l'affectation.
                            </p>
                        </div>


                        <span
                            id="importedRowsCount"
                            class="pill"
                        >
                            0 ligne
                        </span>

                    </div>


                    <div class="table-wrapper">

                        <table>

                            <thead>

                            <tr>
                                <th>SIRET</th>
                                <th>Raison sociale</th>
                                <th>Type</th>
                                <th>N° Abonné</th>
                                <th>Identifiant</th>
                                <th>Contrat BAD</th>
                                <th>Date limite</th>
                            </tr>

                            </thead>


                            <tbody id="importPreviewTable">
                            </tbody>

                        </table>

                    </div>


                    <div class="card-footer">

                        <button
                            class="primary-btn"
                            onclick="goToAssignments()"
                        >
                            Passer aux affectations →
                        </button>

                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             ASSIGNMENTS
        ================================================== -->

        <section
            id="assignments"
            class="page"
        >

            <div class="card">

                <div class="card-header assignment-header">

                    <div>

                        <h3>Affectation des lignes</h3>

                        <p>
                            Sélectionnez un agent pour chaque ligne importée.
                        </p>

                    </div>


                    <div class="assignment-actions">

                        <select id="bulkAgentSelect">
                            <option value="">
                                Affectation en masse...
                            </option>
                        </select>


                        <button
                            class="secondary-btn"
                            onclick="assignAllToSelectedAgent()"
                        >
                            Affecter
                        </button>


                        <button
                            id="validateAssignmentsButton"
                            class="primary-btn"
                            onclick="validateAssignments()"
                        >
                            ✓ Valider les affectations
                        </button>

                    </div>

                </div>


                <div class="assignment-toolbar">

                    <input
                        id="assignmentSearch"
                        type="search"
                        placeholder="Rechercher SIRET ou raison sociale..."
                    >


                    <select id="assignmentFilter">

                        <option value="all">
                            Toutes les lignes
                        </option>

                        <option value="unassigned">
                            Non affectées
                        </option>

                        <option value="assigned">
                            Affectées
                        </option>

                    </select>

                </div>


                <div class="table-wrapper">

                    <table>

                        <thead>

                        <tr>
                            <th>
                                <input
                                    id="selectAllLines"
                                    type="checkbox"
                                >
                            </th>

                            <th>SIRET</th>
                            <th>Raison sociale</th>
                            <th>Type</th>
                            <th>Date limite</th>
                            <th>Agent</th>
                            <th>Statut</th>
                        </tr>

                        </thead>


                        <tbody id="assignmentTable">
                        </tbody>

                    </table>

                </div>

            </div>

        </section>


        <!-- =================================================
             AGENTS
        ================================================== -->

        <section
            id="agents"
            class="page"
        >

            <div class="card">

                <div class="card-header">

                    <div>
                        <h3>Agents</h3>
                        <p>
                            Gérez les agents disponibles pour les affectations.
                        </p>
                    </div>


                    <button
                        class="primary-btn"
                        onclick="showAddAgentForm()"
                    >
                        + Ajouter un agent
                    </button>

                </div>


                <div
                    id="addAgentForm"
                    class="add-agent-form hidden"
                >

                    <div class="form-field">

                        <label for="newAgentId">
                            Identifiant
                        </label>

                        <input
                            id="newAgentId"
                            type="text"
                            placeholder="Ex : HAMDANMO"
                        >

                    </div>


                    <div class="form-field">

                        <label for="newAgentName">
                            Nom affiché
                        </label>

                        <input
                            id="newAgentName"
                            type="text"
                            placeholder="Ex : Mohamed Hamdan"
                        >

                    </div>


                    <button
                        class="primary-btn"
                        onclick="addAgent()"
                    >
                        Ajouter
                    </button>


                    <button
                        class="secondary-btn"
                        onclick="hideAddAgentForm()"
                    >
                        Annuler
                    </button>

                </div>


                <div
                    id="agentsList"
                    class="agents-grid"
                >
                </div>

            </div>

        </section>

    </main>

</div>


<!-- =========================================================
     TOAST
========================================================== -->

<div
    id="toast"
    class="toast"
>
</div>


<!-- =========================================================
     SHEETJS
========================================================== -->

<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

<script src="js/manager.js"></script>

</body>

</html>
