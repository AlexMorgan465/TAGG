            state.source.importedAt
        ]
    ];
}


function renderInformation(
    container,
    information
) {

    if (!container) {
        return;
    }


    container.innerHTML = "";


    information.forEach(
        ([label, value]) => {

            const item =
                document.createElement("div");

            item.className = "info-item";


            const labelElement =
                document.createElement("span");

            labelElement.className =
                "info-label";

            labelElement.textContent =
                label;


            const valueElement =
                document.createElement("span");

            valueElement.className =
                "info-value";

            valueElement.textContent =
                value || "—";


            item.append(
                labelElement,
                valueElement
            );


            container.appendChild(item);
        }
    );
}


/* ============================================================
   IMPORT PAGE
============================================================ */

function renderImportPage() {

    const result =
        document.getElementById(
            "importResult"
        );

    if (!result) {
        return;
    }


    if (state.lines.length === 0) {

        result.classList.add("hidden");
        return;
    }


    result.classList.remove("hidden");


    const fileName =
        document.getElementById(
            "importFileName"
        );

    if (fileName) {

        fileName.textContent =
            state.source.fileName || "—";
    }


    const count =
        document.getElementById(
            "importedRowsCount"
        );

    if (count) {

        count.textContent =
            `${state.lines.length} ligne(s)`;
    }


    renderInformation(
        document.getElementById(
            "sourceInformation"
        ),
        getSourceInformation()
    );


    const table =
        document.getElementById(
            "importPreviewTable"
        );

    if (!table) {
        return;
    }


    table.innerHTML = "";


    state.lines.forEach(item => {

        const tr =
            document.createElement("tr");


        addCell(
            tr,
            item.line.siret
        );

        addCell(
            tr,
            item.line.raisonSociale,
            true
        );

        addCell(
            tr,
            item.line.typeFacture || "—"
        );

        addCell(
            tr,
            item.line.numeroAbonne || "—"
        );

        addCell(
            tr,
            item.line.identifiant || "—"
        );

        addCell(
            tr,
            item.line.contratBAD || "—"
        );

        addCell(
            tr,
            item.line.dateLimite || "—"
        );


        table.appendChild(tr);
    });
}


function addCell(
    row,
    value,
    bold = false
) {

    const td =
        document.createElement("td");

    if (bold) {

        const strong =
            document.createElement("strong");

