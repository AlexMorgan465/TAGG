/* ==========================================================
   LOAD MANAGER DATA FILE
========================================================== */

function loadManagerAssignments() {

    return new Promise(
        resolve => {

            window.AGENT_DATA =
                null;


            /*
                Remove previous data script.
            */

            const previous =
                document.getElementById(
                    "agentDataScript"
                );


            if (previous) {

                previous.remove();

            }


            const script =
                document.createElement(
                    "script"
                );


            script.id =
                "agentDataScript";


            /*
                Timestamp prevents browser caching.
            */

            script.src =
                `data/agents/${encodeURIComponent(AGENT.id)}.js?t=${Date.now()}`;


            script.onload =
                () => {

                    if (
                        window.AGENT_DATA
                    ) {

                        if (
                            window.AGENT_DATA.agentName
                        ) {

                            AGENT.name =
                                window.AGENT_DATA.agentName;

                        }


                        mergeManagerAssignments(
                            window.AGENT_DATA.assignments || []
                        );

                    }


                    resolve(true);

                };


            script.onerror =
                () => {

                    console.warn(
                        `Aucun fichier d'affectation pour ${AGENT.id}.`
                    );


                    /*
                        Do NOT delete local work just because
                        Manager file couldn't be read.
                    */

                    renderAll();

                    resolve(false);

                };


            document.body.appendChild(
                script
            );

        }
    );

}


/* ==========================================================
   MERGE MANAGER DATA
========================================================== */

function mergeManagerAssignments(
    managerAssignments
) {

    const completedIds =
        new Set(
            state.completed.map(
                item => item.id
            )
        );


    const existingMap =
        new Map(
            state.assignments.map(
                item => [
                    item.id,
                    item
                ]
            )
        );


    const merged =
        [];


    managerAssignments.forEach(
        managerItem => {

            /*
                Never recreate a locally completed line.
            */

            if (
                completedIds.has(
                    managerItem.id
                )
            ) {

                return;

            }


            const existing =
                existingMap.get(
                    managerItem.id
                );


            /*
                Preserve an active treatment.
            */

            if (
                existing &&
                existing.status ===
                    "processing"
            ) {

                merged.push(
                    existing
                );

                return;

            }


            merged.push({

                ...managerItem,

                status:
                    "pending"

            });

        }
    );


    /*
        If an active treatment was removed from
        Manager while the agent was working on it,
        preserve it until the agent finishes/cancels.
    */

    if (
        state.activeTreatmentId
    ) {

        const activeExisting =
            existingMap.get(
                state.activeTreatmentId
            );


        const alreadyIncluded =
            merged.some(
                item =>
                    item.id ===
                    state.activeTreatmentId
            );


        if (
            activeExisting &&
            !alreadyIncluded
        ) {

            merged.push(
                activeExisting
            );

        }

    }


    state.assignments =
        merged;


    saveState();

    initializeAgent();

    renderAll();

}


/* ==========================================================
   REFRESH
========================================================== */

async function refreshAssignments() {

    const loaded =
        await loadManagerAssignments();


    if (loaded) {

        showToast(
            "Affectations actualisées."
        );

    }
    else {

        showToast(
            "Aucune nouvelle affectation disponible."
        );

    }

}


