function addAgent() {

    const id =
        document.getElementById(
            "newAgentId"
        )
        .value
        .trim()
        .toUpperCase()
        .replace(
            /\s+/g,
            ""
        );


    const name =
        document.getElementById(
            "newAgentName"
        )
        .value
        .trim();


    if (
        !id
    ) {

        showToast(
            "Saisissez l'identifiant de l'agent."
        );

        return;

    }


    const exists =
        state.agents.some(
            agent =>
                agent.id ===
                id
        );


    if (
        exists
    ) {

        showToast(
            "Cet agent existe déjà."
        );

        return;

    }


    state.agents.push({

        id,

        name:
            name || id

    });


    state.validated =
        false;


    saveState();

    hideAddAgentForm();

    renderAll();


    showToast(
        "Agent ajouté."
    );

}


/* ============================================================
   REMOVE AGENT
============================================================ */

function removeAgent(
    agentId
) {

    const agent =
        state.agents.find(
            item =>
                item.id ===
                agentId
        );


    if (!agent) {
        return;
    }


    const assignedLines =
        state.lines.filter(
            line =>
                line.assignedTo ===
                agentId
        );


    if (
        assignedLines.length >
        0
    ) {

        const confirmation =
            confirm(
                `${agent.name} possède ${assignedLines.length} ligne(s) affectée(s).\n\n` +
                "Ces lignes redeviendront non affectées.\n\n" +
                "Continuer ?"
            );


        if (
            !confirmation
        ) {

            return;

        }

    }


    /*
        Unassign lines.
    */

    state.lines.forEach(
        line => {

            if (
                line.assignedTo ===
                agentId
            ) {

                line.assignedTo =
                    null;

            }

        }
    );


    /*
        Remove agent.
    */

    state.agents =
        state.agents.filter(
            item =>
                item.id !==
                agentId
        );


    state.validated =
        false;


    saveState();

    renderAll();


    showToast(
        "Agent supprimé."
    );

}


