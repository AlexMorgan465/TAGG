/* ============================================================
   EXCEL IMPORT
============================================================ */

function importExcelFile(
    file
) {

    if (
        typeof XLSX ===
        "undefined"
    ) {

        showToast(
            "SheetJS n'est pas disponible."
        );

        return;

    }


    const reader =
        new FileReader();


    reader.onload =
        event => {

            try {

                const bytes =
                    new Uint8Array(
                        event.target.result
                    );


                const workbook =
                    XLSX.read(
                        bytes,
                        {
                            type: "array",

                            cellDates: true,

                            cellText: true
                        }
                    );


                if (
                    workbook.SheetNames.length ===
                    0
                ) {

                    showToast(
                        "Le classeur ne contient aucune feuille."
                    );

                    return;

                }


                /*
                    We currently use first worksheet.
                */

                const worksheetName =
                    workbook.SheetNames[0];


                const worksheet =
                    workbook.Sheets[
                        worksheetName
                    ];


                const rows =
                    XLSX.utils.sheet_to_json(
                        worksheet,
                        {
                            header: 1,

                            defval: "",

                            raw: false,

                            blankrows: false
                        }
                    );


                if (
                    rows.length ===
                    0
                ) {

                    showToast(
                        "Aucune donnée détectée."
                    );

                    return;

                }


                processExcelData(
                    rows,
                    file.name
                );

            }
            catch (error) {

                console.error(
                    "Erreur import Excel:",
                    error
                );


                showToast(
                    "Impossible de lire le fichier Excel."
                );

            }

        };


    reader.onerror =
        () => {

            showToast(
                "Erreur pendant la lecture du fichier."
            );

        };


    reader.readAsArrayBuffer(
        file
    );

}


/* ============================================================
   NORMALIZE TEXT
============================================================ */

function normalizeText(
    value
) {

    return String(
        value ?? ""
    )
    .normalize(
        "NFD"
    )
    .replace(
        /[\u0300-\u036f]/g,
        ""
    )
    .replace(
        /\s+/g,
        " "
    )
    .trim()
    .toLowerCase();

}


/* ============================================================
   FIND VALUE NEAR LABEL
============================================================ */

function findValueNearLabel(
    rows,
    possibleLabels
) {

    const labels =
        possibleLabels.map(
            normalizeText
        );


    for (
        let rowIndex = 0;
        rowIndex < rows.length;
        rowIndex++
    ) {

        const row =
            rows[
                rowIndex
            ];


        for (
            let columnIndex = 0;
            columnIndex < row.length;
            columnIndex++
        ) {

            const cell =
                normalizeText(
                    row[
                        columnIndex
                    ]
                );


            if (
                !cell
            ) {
                continue;
            }


            const matches =
                labels.some(
                    label =>

                        cell === label

                        ||

                        cell.includes(
                            label
                        )
                );


            if (
                !matches
            ) {
                continue;
            }


            /*
                First try cells on the right.
            */

            for (
                let offset = 1;
                offset <= 4;
                offset++
            ) {

                const value =
                    row[
                        columnIndex +
                        offset
                    ];


                if (
                    value !== undefined &&
                    String(value).trim() !== ""
                ) {

                    return String(
                        value
                    ).trim();

                }

            }


            /*
                Then try next row.
            */

            if (
                rows[
                    rowIndex + 1
                ]
            ) {

                for (
                    let offset = 0;
                    offset <= 3;
                    offset++
                ) {

                    const value =
                        rows[
                            rowIndex + 1
                        ][
                            columnIndex +
                            offset
                        ];


                    if (
                        value !== undefined &&
                        String(value).trim() !== ""
                    ) {

                        return String(
                            value
                        ).trim();

                    }

                }

            }

        }

    }


    return "";

}


/* ============================================================
   FIND CLIENT TABLE HEADER
============================================================ */

function findClientHeaderRow(
    rows
) {

    for (
        let index = 0;
        index < rows.length;
        index++
    ) {

        const normalizedRow =
            rows[index]
                .map(
                    normalizeText
                );


        const hasSiret =
            normalizedRow.some(
                cell =>
                    cell.includes(
                        "siret"
                    )
            );


        const hasCompany =
            normalizedRow.some(
                cell =>

                    cell.includes(
                        "raison sociale"
                    )

                    ||

                    cell.includes(
                        "raison"
                    )
            );


        if (
            hasSiret &&
            hasCompany
        ) {

            return index;

        }

    }


    return -1;

}


/* ============================================================
   FIND COLUMN
============================================================ */

function findColumnIndex(
    headers,
    possibleNames
) {

    const normalizedHeaders =
        headers.map(
            normalizeText
        );


    const normalizedNames =
        possibleNames.map(
            normalizeText
        );


    /*
        Exact first.
    */

    for (
        const name
        of normalizedNames
    ) {

        const index =
            normalizedHeaders.findIndex(
                header =>
                    header === name
            );


        if (
            index !== -1
        ) {

            return index;

        }

    }


    /*
        Partial second.
    */

    for (
        const name
        of normalizedNames
    ) {

        const index =
            normalizedHeaders.findIndex(
                header =>

                    header.includes(
                        name
                    )

                    ||

                    name.includes(
                        header
                    )
            );


        if (
            index !== -1
        ) {

            return index;

        }

    }


    return -1;

}


/* ============================================================
   CELL VALUE
============================================================ */

function cellValue(
    row,
    index
) {

    if (
        index === -1 ||
        index === undefined
    ) {

        return "";

    }


    return String(
        row[index] ?? ""
    ).trim();

}


/* ============================================================
   CLEAN SIRET
============================================================ */

function cleanSiret(
    value
) {

    /*
        Excel sometimes returns numbers with spaces
        or scientific formatting.

        Here we preserve string representation and
        remove spaces.
    */

    return String(
        value ?? ""
    )
    .replace(
        /\s+/g,
        ""
    )
    .trim();

}


/* ============================================================
   GENERATE STABLE LINE ID
============================================================ */

function createLineId(
    siret,
    company,
    rowIndex
) {

    const safeSiret =
        cleanSiret(
            siret
        )
        .replace(
            /[^a-zA-Z0-9]/g,
            ""
        );


    const safeCompany =
        normalizeText(
            company
        )
        .replace(
            /[^a-z0-9]/g,
            ""
        )
        .substring(
            0,
            20
        );


    return (
        "LINE-" +
        (
            safeSiret ||
            safeCompany ||
            "ROW"
        )
        +
        "-" +
        rowIndex
    );

}


/* ============================================================
   PROCESS EXCEL
============================================================ */

function processExcelData(
    rows,
    fileName
) {

    /*
        =====================================================
        1. SOURCE INFORMATION
        =====================================================
    */

    const source = {

        fileName:
            fileName,

        nomCSP:
            findValueNearLabel(
                rows,
                [
                    "Coordonnées du CSP",
                    "Nom CSP",
                    "CSP"
                ]
            ),

        contratBAD:
            findValueNearLabel(
                rows,
                [
                    "Contrat BAD",
                    "Contrat B@D"
                ]
            ),

        idtConnexion:
            findValueNearLabel(
                rows,
                [
                    "Idt de connexion",
                    "Identifiant de connexion",
                    "IDT connexion"
                ]
            ),

        mdpCSP:
            findValueNearLabel(
                rows,
                [
                    "Mdp CSP",
                    "Mot de passe CSP"
                ]
            ),

        numeroAbonneCSP:
            findValueNearLabel(
                rows,
                [
                    "N° Abonné CSP",
                    "N Abonné CSP",
                    "Numero Abonné CSP",
                    "Numéro Abonné CSP"
                ]
            ),

        iban:
            findValueNearLabel(
                rows,
                [
                    "IBAN de prélèvement",
                    "IBAN"
                ]
            ),

        importedAt:
            new Date()
                .toLocaleString(
                    "fr-FR"
                )

    };


    /*
        In the workbook screenshot, CYBERG may appear
        as a title above "Coordonnées du CSP".

        If CSP detection returned the label itself,
        try to detect the value immediately above.
    */

    if (
        !source.nomCSP ||
        normalizeText(
            source.nomCSP
        ).includes(
            "coordonnees"
        )
    ) {

        source.nomCSP =
            detectCSPTitle(
                rows
            );

    }


    /*
        =====================================================
        2. CLIENT TABLE
        =====================================================
    */

    const headerRowIndex =
        findClientHeaderRow(
            rows
        );


    if (
        headerRowIndex ===
        -1
    ) {

        showToast(
            "Le tableau client n'a pas été détecté."
        );

        return;

    }


    const headers =
        rows[
            headerRowIndex
        ];


    /*
        Column mapping
    */

    const columns = {

        siret:
            findColumnIndex(
                headers,
                [
                    "SIRET du siège social",
                    "SIRET"
                ]
            ),

        raisonSociale:
            findColumnIndex(
                headers,
                [
                    "RAISON SOCIALE",
                    "Raison sociale"
                ]
            ),

        typeFacture:
            findColumnIndex(
                headers,
                [
                    "Factures en émission et/ou réception",
                    "E/R/E+R",
                    "facture type",
                    "Type facture"
                ]
            ),

        numeroAbonne:
            findColumnIndex(
                headers,
                [
                    "N° Abonné e-factures",
                    "N Abonné e-factures",
                    "Numero Abonné e-factures"
                ]
            ),

        identifiant:
            findColumnIndex(
                headers,
                [
                    "Identifiant"
                ]
            ),

        mdp:
            findColumnIndex(
                headers,
                [
                    "Mdp",
                    "Mot de passe"
                ]
            ),

        contratBAD:
            findColumnIndex(
                headers,
                [
                    "Contrat B@D",
                    "Contrat BAD"
                ]
            ),

        rattachement:
            findColumnIndex(
                headers,
                [
                    "Rattachement au contrat CSP",
                    "Rattachement"
                ]
            ),

        dateLimite:
            findColumnIndex(
                headers,
                [
                    "Date limite de traitement",
                    "Date limite"
                ]
            ),

        commentaire:
            findColumnIndex(
                headers,
                [
                    "Commentaire"
                ]
            )

    };


    /*
        Essential columns.
    */

    if (
        columns.siret === -1 ||
        columns.raisonSociale === -1
    ) {

        console.error(
            "Colonnes détectées:",
            columns
        );


        showToast(
            "Les colonnes SIRET / Raison sociale n'ont pas été détectées."
        );

        return;

    }


    const importedLines =
        [];


    /*
        Start after header.
    */

    for (
        let index =
            headerRowIndex + 1;

        index <
            rows.length;

        index++
    ) {

        const row =
            rows[index];


        const siret =
            cleanSiret(
                cellValue(
                    row,
                    columns.siret
                )
            );


        const raisonSociale =
            cellValue(
                row,
                columns.raisonSociale
            );


        /*
            Empty/end row.
        */

        if (
            !siret &&
            !raisonSociale
        ) {

            continue;

        }


        /*
            Ignore rows that clearly aren't client rows.
        */

        if (
            normalizeText(
                siret
            ).includes(
                "siret"
            )
        ) {

            continue;

        }


        importedLines.push({

            id:
                createLineId(
                    siret,
                    raisonSociale,
                    index
                ),

            assignedTo:
                null,

            selected:
                false,

            line: {

                siret:
                    siret,

                raisonSociale:
                    raisonSociale,

                typeFacture:
                    cellValue(
                        row,
                        columns.typeFacture
                    ),

                numeroAbonne:
                    cellValue(
                        row,
                        columns.numeroAbonne
                    ),

                identifiant:
                    cellValue(
                        row,
                        columns.identifiant
                    ),

                mdp:
                    cellValue(
                        row,
                        columns.mdp
                    ),

                contratBAD:
                    cellValue(
                        row,
                        columns.contratBAD
                    ),

                rattachement:
                    cellValue(
                        row,
                        columns.rattachement
                    ),

                dateLimite:
                    cellValue(
                        row,
                        columns.dateLimite
                    ),

                commentaire:
                    cellValue(
                        row,
                        columns.commentaire
                    )

            }

        });

    }


    if (
        importedLines.length ===
        0
    ) {

        showToast(
            "Aucune ligne client détectée."
        );

        return;

    }


    /*
        Replace previous import.
    */

    state.source =
        source;


    state.lines =
        importedLines;


    state.validated =
        false;


    saveState();


    renderAll();


    showPage(
        "import"
    );


    showToast(
        `${importedLines.length} ligne(s) importée(s).`
    );

}


/* ============================================================
   DETECT CSP TITLE
============================================================ */

function detectCSPTitle(
    rows
) {

    for (
        let rowIndex = 0;
        rowIndex < rows.length;
        rowIndex++
    ) {

        const row =
            rows[
                rowIndex
            ];


        for (
            let columnIndex = 0;
            columnIndex < row.length;
            columnIndex++
        ) {

            const cell =
                normalizeText(
                    row[
                        columnIndex
                    ]
                );


            if (
                cell.includes(
                    "coordonnees du csp"
                )
            ) {

                /*
                    Search above.
                */

                for (
                    let offset = 1;
                    offset <= 3;
                    offset++
                ) {

                    const previousRow =
                        rows[
                            rowIndex -
                            offset
                        ];


                    if (
                        !previousRow
                    ) {
                        continue;
                    }


                    const candidate =
                        previousRow[
                            columnIndex
                        ];


                    if (
                        candidate &&
                        String(candidate).trim()
                    ) {

                        return String(
                            candidate
                        ).trim();

                    }


                    /*
                        Search whole previous row.
                    */

                    const firstValue =
                        previousRow.find(
                            value =>
                                String(
                                    value ?? ""
                                ).trim()
                        );


                    if (
                        firstValue
                    ) {

                        return String(
                            firstValue
                        ).trim();

                    }

                }

            }

        }

    }


    return "";

}


