/* ==========================================================
   SELECT LINE
========================================================== */

function selectLine(id) {

    const item =
        state.assignments.find(
            row => row.id === id
        );


    if (!item) {
        return;
    }


    /*
        If another line is already actively being processed,
        don't allow a second treatment.
    */

    if (
        state.activeTreatmentId &&
        state.activeTreatmentId !== id
    ) {

        showToast(
            "Une autre ligne est déjà en cours de traitement."
        );

        return;

    }


    selectedLineId = id;


    renderPendingList();

    displaySelectedLine(item);

}


/* ==========================================================
   DISPLAY DETAILS
========================================================== */

function displaySelectedLine(item) {

    emptySelection.classList.add(
        "hidden"
    );


    selectedDetails.classList.remove(
        "hidden"
    );


    document.getElementById(
        "selectedCompany"
    ).textContent =
