/* ============================================================
   ASSIGNMENTS
============================================================ */

function renderAssignments() {

    updateCounters();

    renderBulkAgentSelect();


    const table =
        document.getElementById(
            "assignmentTable"
        );


    table.innerHTML =
        "";


    const search =
        document.getElementById(
            "assignmentSearch"
        )
        .value
        .trim()
        .toLowerCase();


    const filter =
        document.getElementById(
            "assignmentFilter"
        ).value;


    const filtered =
        state.lines.filter(
            item => {

                const matchesSearch =

                    item.line.siret
                        .toLowerCase()
                        .includes(
                            search
                        )

                    ||

                    item.line.raisonSociale
                        .toLowerCase()
                        .includes(
                            search
                        );


                let matchesFilter =
                    true;


                if (
                    filter ===
                    "assigned"
                ) {

                    matchesFilter =
                        Boolean(
                            item.assignedTo
                        );

                }


                if (
                    filter ===
                    "unassigned"
                ) {

                    matchesFilter =
                        !item.assignedTo;

                }


                return (
                    matchesSearch &&
                    matchesFilter
                );

            }
        );


    if (
        filtered.length ===
        0
    ) {

        table.innerHTML = `

            <tr>

                <td
                    colspan="7"
                    style="
                        text-align:center;
                        padding:35px;
                        color:#9ca3af;
                    "
                >
                    Aucune ligne.
                </td>

            </tr>

        `;


        return;

    }


    filtered.forEach(
        item => {

            const row =
                document.createElement(
                    "tr"
                );


            row.innerHTML = `

                <td>

                    <input
                        type="checkbox"
                        class="line-checkbox"
                        data-id="${escapeHTML(item.id)}"
                        ${item.selected ? "checked" : ""}
                    >

                </td>


                <td>
                    ${escapeHTML(item.line.siret)}
                </td>


                <td>

                    <strong>
                        ${escapeHTML(item.line.raisonSociale)}
                    </strong>

                </td>


                <td>
                    ${escapeHTML(item.line.typeFacture || "—")}
                </td>


                <td>
                    ${escapeHTML(item.line.dateLimite || "—")}
                </td>


                <td>

                    <select
                        class="agent-assignment-select"
                        data-id="${escapeHTML(item.id)}"
                    >

                        ${createAgentOptions(
                            item.assignedTo
                        )}

                    </select>

                </td>


                <td>

                    ${
                        item.assignedTo

                        ? `
                            <span class="status success-status">
                                Affectée
                            </span>
                          `

                        : `
                            <span class="status pending-status">
                                À affecter
                            </span>
                          `
                    }

                </td>

            `;


            table.appendChild(
                row
            );

        }
    );


    /*
        Checkbox events.
    */

    table
        .querySelectorAll(
            ".line-checkbox"
        )
        .forEach(
            checkbox => {

                checkbox.addEventListener(
                    "change",
                    event => {

                        const item =
                            state.lines.find(
                                line =>
                                    line.id ===
                                    event.target.dataset.id
                            );


                        if (!item) {
                            return;
                        }


                        item.selected =
                            event.target.checked;


                        saveState();

                    }
                );

            }
        );


    /*
        Assignment select events.
    */

    table
        .querySelectorAll(
            ".agent-assignment-select"
        )
        .forEach(
            select => {

                select.addEventListener(
                    "change",
                    event => {

                        assignLine(
                            event.target.dataset.id,
                            event.target.value
                        );

                    }
                );

            }
        );

}


/* ============================================================
   ASSIGN SINGLE LINE
============================================================ */

function assignLine(
    lineId,
    agentId
) {

    const line =
        state.lines.find(
            item =>
                item.id ===
                lineId
        );


    if (!line) {
        return;
    }


    line.assignedTo =
        agentId || null;


    /*
        Any change means the previous validation
        is no longer final.
    */

    state.validated =
        false;


    saveState();

    renderAssignments();

    renderDashboard();

}


