    txtFechaNuevo.Value = Format$(Date, "dd/mm/yyyy")
    txtReferenciaNuevo.Value = ""
    cmbCanalNuevo.ListIndex = -1
    cmbActividadNuevo.ListIndex = -1
    cmbMotivoNuevo.ListIndex = -1
    txtCommentaireNuevo.Value = ""
End Sub

Private Sub RefreshListView(Optional ByVal filterCol As Long = 0, Optional ByVal query As String = "")
    Dim ws As Worksheet, r As Long, j As Long, idx As Long, h As Variant
    loading = True
    currentRow = 0
    Set ws = GetTempSheet()
    Set rowMap = New Collection
    vue.RowSource = ""
    vue.Clear
    vue.ColumnCount = 7
    vue.ColumnHeads = False
    vue.ColumnWidths = "75;100;135;100;135;150;75"
    h = Headers()
    vue.AddItem h(0)
    For j = 1 To 5
        vue.List(0, j) = h(j)
    Next j
    vue.List(0, 6) = "ETAT"
    rowMap.Add 0
    For r = 2 To LastRow(ws)
        If IsDate(ws.Cells(r, 2).Value) Then
            If filterCol = 0 Then
                idx = 1
            Else
                idx = InStr(1, CStr(ws.Cells(r, filterCol).Value), query, vbTextCompare)
            End If
            If idx > 0 Then
                vue.AddItem Format$(ws.Cells(r, 2).Value, "dd/mm/yyyy")
                For j = 1 To 5
                    vue.List(vue.ListCount - 1, j) = CStr(ws.Cells(r, 2 + j).Value)
                Next j
                If Len(CStr(ws.Cells(r, 9).Value)) = 0 Then
                    vue.List(vue.ListCount - 1, 6) = "En attente"
                Else
                    vue.List(vue.ListCount - 1, 6) = "Termine"
                End If
                rowMap.Add r
            End If
        End If
    Next r
    loading = False
End Sub

Private Sub WriteStart(ByVal ws As Worksheet, ByVal r As Long, ByVal started As Date)
    ws.Cells(r, 1).Value = Environ$("USERNAME")
    ws.Cells(r, 8).Value = started
    ws.Cells(r, 2).Value = DateValue(started)
    ws.Cells(r, 2).NumberFormat = "dd/mm/yyyy"
    ws.Cells(r, 3).NumberFormat = "@"
    ws.Cells(r, 3).Value = Trim$(txtReferenciaNuevo.Value)
    ws.Cells(r, 4).Value = cmbCanalNuevo.Value
End Sub

Private Sub cmb_Ajouter_Click()
    Dim ws As Worksheet, wx As Worksheet, r As Long, tr As Long, er As Long, started As Date
    Dim writing As Boolean, detail As String
    On Error GoTo Failed
    If Len(Trim$(txtReferenciaNuevo.Value)) = 0 Or cmbCanalNuevo.ListIndex < 0 Then
        MsgBox "Veuillez remplir REFERENCIA et CANAL.", vbExclamation
        Exit Sub
    End If
    Set ws = GetTempSheet()
    Set wx = GetExtractSheet()
    EnsureHeaders ws
    EnsureHeaders wx
    For r = 2 To LastRow(ws)
        If IsDate(ws.Cells(r, 2).Value) Then
            If Len(CStr(ws.Cells(r, 9).Value)) = 0 Then
                MsgBox "Terminez le dossier en attente avant d'en ajouter un nouveau.", vbExclamation
                Exit Sub
            End If
            If StrComp(CStr(ws.Cells(r, 3).Value), Trim$(txtReferenciaNuevo.Value), vbTextCompare) = 0 Then
                MsgBox "Cette reference existe deja.", vbExclamation
                Exit Sub
            End If
        End If
    Next r
    tr = LastRow(ws) + 1
    er = LastRow(wx) + 1
    started = Now
    writing = True
    WriteStart ws, tr, started
    WriteStart wx, er, started
    writing = False
    RefreshListView
    For r = 1 To rowMap.Count
        If CLng(rowMap(r)) = tr Then
            vue.ListIndex = r - 1
            Exit For
        End If
    Next r
    LoadSelectedData
    MsgBox "Dossier ajoute. Completez maintenant l'Etape 2.", vbInformation
    Exit Sub
Failed:
    detail = Err.Description
    If writing Then
        On Error Resume Next
        ws.Range(ws.Cells(tr, 1), ws.Cells(tr, 10)).ClearContents
        wx.Range(wx.Cells(er, 1), wx.Cells(er, 10)).ClearContents
        On Error GoTo 0
    End If
    MsgBox "Ajout impossible : " & detail, vbExclamation
End Sub

Private Sub vue_Click()
    If Not loading Then LoadSelectedData
End Sub

Sub LoadSelectedData()
    Dim ws As Worksheet
    currentRow = 0
    If rowMap Is Nothing Then Exit Sub
    If vue.ListIndex <= 0 Then Exit Sub
    Set ws = GetTempSheet()
    currentRow = CLng(rowMap(vue.ListIndex + 1))
    txtFechaNuevo.Value = Format$(ws.Cells(currentRow, 2).Value, "dd/mm/yyyy")
    txtReferenciaNuevo.Value = CStr(ws.Cells(currentRow, 3).Value)
    cmbCanalNuevo.Value = CStr(ws.Cells(currentRow, 4).Value)
    cmbActividadNuevo.Value = CStr(ws.Cells(currentRow, 5).Value)
    cmbMotivoNuevo.Value = CStr(ws.Cells(currentRow, 6).Value)
    txtCommentaireNuevo.Value = CStr(ws.Cells(currentRow, 7).Value)
End Sub

Private Sub cmb_Terminer_Click()
    Dim ws As Worksheet, wx As Worksheet, r As Long, target As Long, finished As Date
    Dim oldTemp As Variant, oldExtract As Variant, writing As Boolean, detail As String
    On Error GoTo Failed
    If currentRow < 2 Then
        MsgBox "Selectionnez d'abord un dossier dans la liste.", vbExclamation
        Exit Sub
    End If
    If cmbActividadNuevo.ListIndex < 0 Or cmbMotivoNuevo.ListIndex < 0 Then
        MsgBox "Veuillez remplir GODIGO ACTIVIDAD et MOTIVO REASIGNADO.", vbExclamation
        Exit Sub
    End If
    Set ws = GetTempSheet()
    Set wx = GetExtractSheet()
    EnsureHeaders ws
    EnsureHeaders wx
    If txtReferenciaNuevo.Value <> CStr(ws.Cells(currentRow, 3).Value) Or cmbCanalNuevo.Value <> CStr(ws.Cells(currentRow, 4).Value) Then
        MsgBox "L'Etape 1 est deja enregistree. Reselectionnez le dossier pour retrouver ses valeurs.", vbExclamation
        Exit Sub
    End If
    For r = 2 To LastRow(wx)
        If CStr(wx.Cells(r, 3).Value) = CStr(ws.Cells(currentRow, 3).Value) Then
            If wx.Cells(r, 8).Value2 = ws.Cells(currentRow, 8).Value2 And CStr(wx.Cells(r, 1).Value) = CStr(ws.Cells(currentRow, 1).Value) Then
                target = r
                Exit For
            End If
        End If
    Next r
    If target = 0 Then
        MsgBox "La ligne correspondante est absente de l'extraction. Le dossier n'a pas ete modifie.", vbExclamation
        Exit Sub
    End If
    oldTemp = ws.Range(ws.Cells(currentRow, 1), ws.Cells(currentRow, 10)).Formula
    oldExtract = wx.Range(wx.Cells(target, 1), wx.Cells(target, 10)).Formula
    finished = Now
    If IsDate(ws.Cells(currentRow, 9).Value) Then finished = CDate(ws.Cells(currentRow, 9).Value)
    writing = True
    WriteFinish ws, currentRow, finished
    WriteFinish wx, target, finished
    writing = False
    clearform
    RefreshListView
    MsgBox "Etape 2 enregistree.", vbInformation
    Exit Sub
Failed:
    detail = Err.Description
    If writing Then
        On Error Resume Next
        ws.Range(ws.Cells(currentRow, 1), ws.Cells(currentRow, 10)).Formula = oldTemp
        wx.Range(wx.Cells(target, 1), wx.Cells(target, 10)).Formula = oldExtract
        On Error GoTo 0
    End If
    MsgBox "Enregistrement impossible : " & detail, vbExclamation
End Sub

Private Sub WriteFinish(ByVal ws As Worksheet, ByVal r As Long, ByVal finished As Date)
    Dim durationCol As Long
    durationCol = 10
    ws.Cells(r, 9).Value = finished
    ws.Cells(r, durationCol).Value = finished - CDate(ws.Cells(r, 8).Value)
    ws.Cells(r, durationCol).NumberFormat = "[h]:mm:ss"
    ws.Cells(r, 5).Value = cmbActividadNuevo.Value
    ws.Cells(r, 6).Value = cmbMotivoNuevo.Value
    ws.Cells(r, 7).NumberFormat = "@"
    ws.Cells(r, 7).Value = txtCommentaireNuevo.Value
End Sub

