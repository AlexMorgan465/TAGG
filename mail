Yep. Create a folder such as PeopleList, then create these 3 files inside it.

index.html

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>People Manager</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<div class="container">

    <div class="header">
        <div>
            <h1>People Manager</h1>
            <p>Manage your list of people</p>
        </div>

        <div class="counter">
            <span id="peopleCount">0</span>
            <small>People</small>
        </div>
    </div>


    <div class="add-section">

        <h2>Add a person</h2>

        <div class="form">

            <input
                type="text"
                id="name"
                placeholder="Full name"
            >

            <input
                type="number"
                id="age"
                placeholder="Age"
                min="1"
            >

            <button id="addBtn">
                + Add Person
            </button>

        </div>

    </div>


    <div class="list-section">

        <div class="list-header">
            <h2>People</h2>

            <button id="clearBtn" class="clear-btn">
                Clear All
            </button>
        </div>

        <div id="peopleList"></div>

        <div id="emptyMessage" class="empty">
            No people added yet.
        </div>

    </div>

</div>


<script src="script.js"></script>

</body>
</html>

