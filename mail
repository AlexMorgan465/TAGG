/* ============================================================
   STATE
============================================================ */

function createDefaultState() {

    return {

        source: {
            fileName: "",
            nomCSP: "",
            contratBAD: "",
            idtConnexion: "",
            mdpCSP: "",
            numeroAbonneCSP: "",
            iban: "",
            importedAt: ""
        },

        lines: [],

        agents: JSON.parse(
            JSON.stringify(DEFAULT_AGENTS)
        ),

        validated: false
    };
}


function loadState() {

    const saved = localStorage.getItem(STORAGE_KEY);

    if (!saved) {
        return createDefaultState();
    }

    try {

        const parsed = JSON.parse(saved);

        if (!parsed.source) {
            parsed.source = createDefaultState().source;
        }

        if (!Array.isArray(parsed.lines)) {
            parsed.lines = [];
        }

        if (!Array.isArray(parsed.agents)) {
            parsed.agents = JSON.parse(
                JSON.stringify(DEFAULT_AGENTS)
            );
        }

        if (typeof parsed.validated !== "boolean") {
            parsed.validated = false;
        }

        return parsed;

    } catch (error) {

        console.error(
            "Erreur chargement localStorage :",
            error
        );

        return createDefaultState();
    }
}


let state = loadState();


function saveState() {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(state)
    );
}


/* ============================================================
   TOAST
============================================================ */

let toastTimer = null;


function showToast(message) {

    const toast =
        document.getElementById("toast");

    if (!toast) {

        alert(message);
        return;
    }

    toast.textContent = message;

    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(
        () => {
            toast.classList.remove("show");
        },
        3500
    );
}


/* ============================================================
   CONNEXION AU DOSSIER
============================================================ */

async function connectSharedFolder() {

    const button =
        document.getElementById(
            "connectFolderButton"
        );

    if (
        typeof window.showDirectoryPicker !==
        "function"
    ) {

        showToast(
            "Ce navigateur n'autorise pas la sélection du dossier."
        );

        return;
    }

    try {

        if (button) {

            button.disabled = true;

            button.textContent =
                "Connexion...";
        }


        /*
            IMPORTANT

            Ici le Manager demande à l'utilisateur
            de sélectionner :

            PeopleList/

            PAS data/
            PAS agents/
        */

        const handle =
            await window.showDirectoryPicker({
                mode: "readwrite"
            });


        /*
            Vérification permission.
        */

        let permission = "prompt";

        if (
            typeof handle.queryPermission ===
            "function"
        ) {

            permission =
                await handle.queryPermission({
                    mode: "readwrite"
                });
        }


        if (
            permission !== "granted" &&
            typeof handle.requestPermission ===
            "function"
        ) {

            permission =
                await handle.requestPermission({
                    mode: "readwrite"
                });
        }


        if (permission !== "granted") {

            throw new Error(
                "L'autorisation d'écriture n'a pas été accordée."
            );
        }


        /*
            Vérification que le dossier sélectionné
            ressemble bien à PeopleList.

            On ne bloque PAS selon le nom exact.
        */

        console.log(
            "Dossier sélectionné :",
            handle.name
        );


        /*
            Accès à data/.
            S'il n'existe pas, Chrome peut le créer.
        */

        const dataHandle =
            await handle.getDirectoryHandle(
                "data",
                {
                    create: true
                }
            );


        /*
            Accès à data/agents/.
        */

        const agentsHandle =
            await dataHandle.getDirectoryHandle(
                "agents",
                {
                    create: true
                }
            );


        /*
            TEST D'ECRITURE REEL.

            On crée temporairement un petit fichier.
        */

        const testFile =
            await agentsHandle.getFileHandle(
                "__test_ecriture.txt",
                {
                    create: true
                }
            );


        const writable =
            await testFile.createWritable();


        await writable.write(
            "Test écriture Gestion Traitement"
        );


        await writable.close();


        /*
            Suppression du fichier de test si
            removeEntry est disponible.
        */

        try {

            if (
                typeof agentsHandle.removeEntry ===
                "function"
            ) {

                await agentsHandle.removeEntry(
                    "__test_ecriture.txt"
                );
            }

        } catch (deleteError) {

            console.warn(
                "Fichier test non supprimé :",
                deleteError
            );
        }


        /*
            Seulement après le test réussi :
        */

        sharedFolderHandle = handle;


        if (button) {

            button.disabled = false;

            button.textContent =
                "✓ Dossier connecté";

            button.classList.add(
                "connected"
            );
        }


        showToast(
            "✓ PeopleList connecté."
        );


        console.log(
            "DOSSIER CONNECTÉ AVEC SUCCÈS"
        );

    } catch (error) {

        console.error(
            "Erreur connexion dossier :",
            error
        );


        sharedFolderHandle = null;


        if (button) {

            button.disabled = false;

            button.textContent =
                "📁 Connecter le dossier";

            button.classList.remove(
                "connected"
            );
        }


        if (error.name === "AbortError") {

            showToast(
                "Sélection du dossier annulée."
            );

            return;
        }


        showToast(
            "Connexion impossible : " +
            (
                error.message ||
                error.name ||
                "Erreur inconnue"
            )
        );
    }
}


