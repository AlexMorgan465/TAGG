/* ============================================================
   HELPERS
============================================================ */

function sanitizeFileName(
    value
) {

    return String(
        value
    )
    .replace(
        /[<>:"/\\|?*]/g,
        "_"
    )
    .trim();

}


function getInitials(
    name
) {

    const words =
        String(
            name || ""
        )
        .trim()
        .split(
            /\s+/
        )
        .filter(
            Boolean
        );


    if (
        words.length ===
        0
    ) {

        return "--";

    }


    if (
        words.length ===
        1
    ) {

        return words[0]
            .substring(
                0,
                2
            )
            .toUpperCase();

    }


    return (
        words[0][0]
        +
        words[
            words.length - 1
        ][0]
    )
    .toUpperCase();

}


function escapeHTML(
    value
) {

    return String(
        value ?? ""
    )
    .replaceAll(
        "&",
        "&amp;"
    )
    .replaceAll(
        "<",
        "&lt;"
    )
    .replaceAll(
        ">",
        "&gt;"
    )
    .replaceAll(
        '"',
        "&quot;"
    )
    .replaceAll(
        "'",
        "&#039;"
    );

}


