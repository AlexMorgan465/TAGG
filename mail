/* ==========================================================
   AGENT ID FROM URL

   Example:
   agent.html?agent=HAMDANMO
========================================================== */

const params =
    new URLSearchParams(
        window.location.search
    );


const AGENT_ID =
    (
        params.get("agent")
        ||
        "HAMDANMO"
    )
    .trim()
    .toUpperCase();


const AGENT = {

    id: AGENT_ID,

    name: AGENT_ID

};


/* ==========================================================
   MANAGER DATA

   This variable will be populated by:
   data/agents/HAMDANMO.js
========================================================== */

window.AGENT_DATA = null;


/* ==========================================================
   LOCAL STORAGE
========================================================== */

const STORAGE_KEY =
    `gestion_traitement_agent_${AGENT.id}`;


function defaultState() {

    return {

        assignments: [],

        completed: [],

        activeTreatmentId: null

    };

}


function loadState() {

    const saved =
        localStorage.getItem(
            STORAGE_KEY
        );


    if (!saved) {

        return defaultState();

    }


    try {

        return JSON.parse(
            saved
        );

    }
    catch {

        return defaultState();

    }

}


let state =
    loadState();


function saveState() {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(state)
    );

}


