            )
    };
}


function loadState() {

    try {

        const saved =
            localStorage.getItem(
                STORAGE_KEY
            );


        if (!saved) {

            return defaultState();
        }


        const result =
            JSON.parse(saved);


        result.lines =
            Array.isArray(result.lines)
                ? result.lines
                : [];


        result.agents =
            Array.isArray(result.agents)
                ? result.agents
                : structuredClone(
                    DEFAULT_AGENTS
                );


        result.source =
            result.source || {};


        return result;

    } catch {

        return defaultState();
    }
}


function saveState() {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(state)
    );
}



