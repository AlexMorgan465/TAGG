/* ============================================================
   AFFECTATIONS
============================================================ */

function renderAssignments() {

    updateCounters();


    const bulkSelect =
        document.getElementById(
            "bulkAgentSelect"
        );


    if (bulkSelect) {

        const previous =
            bulkSelect.value;


        bulkSelect.innerHTML = "";


        const placeholder =
            document.createElement("option");

        placeholder.value = "";

        placeholder.textContent =
            "Affectation en masse...";


        bulkSelect.appendChild(
            placeholder
        );


        state.agents.forEach(agent => {

            const option =
                document.createElement(
                    "option"
                );

            option.value = agent.id;

            option.textContent =
                agent.name;

            bulkSelect.appendChild(
                option
            );
        });


        if (
            state.agents.some(
                agent =>
                    agent.id === previous
            )
        ) {
            bulkSelect.value = previous;
        }
    }


    const table =
        document.getElementById(
            "assignmentTable"
        );

    if (!table) {
        return;
    }


    table.innerHTML = "";


    const searchElement =
        document.getElementById(
            "assignmentSearch"
        );


    const filterElement =
        document.getElementById(
            "assignmentFilter"
        );


    const search =
        searchElement
            ? normalizeText(
                searchElement.value
            )
            : "";


    const filter =
        filterElement
            ? filterElement.value
            : "all";


    const lines =
        state.lines.filter(item => {

            const matchesSearch =

                normalizeText(
                    item.line.siret
                ).includes(search)

                ||

                normalizeText(
                    item.line.raisonSociale
                ).includes(search);


            let matchesFilter = true;


            if (filter === "assigned") {

                matchesFilter =
                    Boolean(
                        item.assignedTo
                    );
            }


            if (filter === "unassigned") {

                matchesFilter =
                    !item.assignedTo;
            }


            return (
                matchesSearch &&
                matchesFilter
            );
        });


    if (lines.length === 0) {

        const tr =
            document.createElement("tr");

        const td =
            document.createElement("td");

        td.colSpan = 7;

        td.textContent =
            "Aucune ligne.";

        td.style.textAlign =
            "center";

        td.style.padding =
            "35px";

        tr.appendChild(td);

        table.appendChild(tr);

        return;
    }


    lines.forEach(item => {

        const tr =
            document.createElement("tr");


        /*
            Checkbox
        */

        const checkboxCell =
            document.createElement("td");

        const checkbox =
            document.createElement("input");

        checkbox.type = "checkbox";

        checkbox.checked =
            Boolean(item.selected);


        checkbox.addEventListener(
            "change",
            () => {

                item.selected =
                    checkbox.checked;

                saveState();
            }
        );


        checkboxCell.appendChild(
            checkbox
        );

        tr.appendChild(
            checkboxCell
        );


        addCell(
            tr,
            item.line.siret
        );

        addCell(
            tr,
            item.line.raisonSociale,
            true
        );

        addCell(
            tr,
            item.line.typeFacture || "—"
        );

        addCell(
            tr,
            item.line.dateLimite || "—"
        );


        /*
            Select agent
        */

        const selectCell =
            document.createElement("td");

        const select =
            document.createElement("select");

        select.className =
            "agent-assignment-select";


        fillAgentSelect(
            select,
            item.assignedTo,
            true
        );


        select.addEventListener(
            "change",
            () => {

                item.assignedTo =
                    select.value || null;

                state.validated = false;

                saveState();

                renderAssignments();

                renderDashboard();
            }
        );


        selectCell.appendChild(select);

        tr.appendChild(selectCell);


        /*
            Statut
        */

        const statusCell =
            document.createElement("td");

        const status =
            document.createElement("span");


        if (item.assignedTo) {

            status.className =
                "status success-status";

            status.textContent =
                "Affectée";

        } else {

            status.className =
                "status pending-status";

            status.textContent =
                "À affecter";
        }


        statusCell.appendChild(status);

        tr.appendChild(statusCell);


        table.appendChild(tr);
    });
}


