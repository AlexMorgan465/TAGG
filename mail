/* ==========================================================
   INFO CARDS
========================================================== */

function renderInformation(
    container,
    information
) {

    container.innerHTML = "";


    information.forEach(
        ([label, value]) => {

            const item =
                document.createElement("div");


            item.className =
                "info-item";


            const labelElement =
                document.createElement("span");


            labelElement.className =
                "info-label";


            labelElement.textContent =
                label;


            const valueElement =
                document.createElement("span");


            valueElement.className =
                "info-value";


            valueElement.textContent =
                value || "—";


            valueElement.title =
                value || "";


            const copy =
                document.createElement("button");


            copy.className =
                "copy-button";


            copy.type = "button";

            copy.title = "Copier";

            copy.textContent = "⧉";


            copy.addEventListener(
                "click",
                event => {

                    event.stopPropagation();

                    copyValue(
                        value || ""
                    );

                }
            );


            item.append(
                labelElement,
                valueElement,
                copy
            );


            container.appendChild(
                item
            );

        }
    );

}


/* ==========================================================
   TAKE LINE
========================================================== */

function takeSelectedLine() {

    if (!selectedLineId) {

        showToast(
            "Sélectionnez une ligne."
        );

        return;

    }


    if (
        state.activeTreatmentId &&
        state.activeTreatmentId !== selectedLineId
    ) {

        showToast(
            "Une ligne est déjà en cours."
        );

        return;

    }


    const item =
        state.assignments.find(
            row =>
                row.id === selectedLineId
        );


    if (!item) {
        return;
    }


    item.status =
        "processing";


    state.activeTreatmentId =
        item.id;


    saveState();


    takeButton.classList.add(
        "hidden"
    );


    treatmentForm.classList.remove(
        "hidden"
    );


    /*
        Useful information is prefilled,
        but the agent can modify it.
    */

    document.getElementById(
        "subscriberNumber"
    ).value =
        item.source.numeroAbonneCSP || "";


    document.getElementById(
        "idt"
    ).value =
        item.source.idtConnexion || "";


    document.getElementById(
        "password"
    ).value =
        item.source.mdpCSP || "";


    document.getElementById(
        "badContract"
    ).value =
        item.source.contratBAD || "";


    document.getElementById(
        "csp"
    ).value =
        item.source.nomCSP || "";


    renderAll();


    showToast(
        "Ligne prise en charge."
    );

}


/* ==========================================================
   CANCEL TREATMENT
========================================================== */

function cancelTreatment() {

    if (!state.activeTreatmentId) {
        return;
    }


    const item =
        state.assignments.find(
            row =>
                row.id ===
                state.activeTreatmentId
        );


    if (item) {
        item.status = "pending";
    }


    state.activeTreatmentId =
        null;


    clearForm();

    saveState();

    renderAll();


    if (item) {
        displaySelectedLine(item);
    }


    showToast(
        "Traitement annulé."
    );

}


/* ==========================================================
   COMPLETE
========================================================== */

function completeTreatment() {

    if (!state.activeTreatmentId) {

        showToast(
            "Aucun traitement en cours."
        );

        return;

    }


    const formData = {

        numeroAbonne:
            valueOf("subscriberNumber"),

        idt:
            valueOf("idt"),

        mdp:
            valueOf("password"),

        contratBAD:
            valueOf("badContract"),

        csp:
            valueOf("csp"),

        commentaire:
            valueOf("comment")

    };


    if (
        !formData.numeroAbonne ||
        !formData.idt ||
        !formData.mdp ||
        !formData.contratBAD ||
        !formData.csp
    ) {

        showToast(
            "Veuillez compléter tous les champs obligatoires."
        );

        return;

    }


    const index =
        state.assignments.findIndex(
            row =>
                row.id ===
                state.activeTreatmentId
        );


    if (index === -1) {
        return;
    }


    const item =
        state.assignments[index];


    const completedItem = {

        ...item,

        status:
            "completed",

        treatment:
            formData,

        completedBy:
            AGENT.name,

        completedAt:
            new Date()
                .toLocaleString(
                    "fr-FR"
                )

    };


    state.completed.unshift(
        completedItem
    );


    state.assignments.splice(
        index,
        1
    );


    state.activeTreatmentId =
        null;


    selectedLineId =
        null;


    saveState();

    clearForm();

    closeDetails();

    renderAll();


    showToast(
        "Traitement terminé avec succès."
    );

}


/* ==========================================================
   HISTORY
========================================================== */

function renderHistory() {

    historyTable.innerHTML = "";


    const search =
        historySearch.value
            .trim()
            .toLowerCase();


    const rows =
        state.completed.filter(
            item => {

                return (
                    item.line.siret
                        .toLowerCase()
                        .includes(search)

                    ||

                    item.line.raisonSociale
                        .toLowerCase()
                        .includes(search)
                );

            }
        );


