function showPage(
    pageName
) {

    document
        .querySelectorAll(
            ".page"
        )
        .forEach(
            page =>
                page.classList.remove(
                    "active"
                )
        );


    document
        .querySelectorAll(
            ".nav-btn"
        )
        .forEach(
            button =>
                button.classList.remove(
                    "active"
                )
        );


    document
        .getElementById(
            pageName
        )
        .classList.add(
            "active"
        );


    document
        .querySelector(
            `[data-page="${pageName}"]`
        )
        .classList.add(
            "active"
        );


    const titles = {

        dashboard: [
            "Tableau de bord",
            "Suivez et traitez vos lignes affectées."
        ],

        pending: [
            "À traiter",
            "Consultez vos lignes affectées."
        ],

        history: [
            "Historique",
            "Consultez vos traitements terminés."
        ]

    };


    document.getElementById(
        "pageTitle"
    ).textContent =
        titles[pageName][0];


    document.getElementById(
        "pageSubtitle"
    ).textContent =
        titles[pageName][1];


    if (
        pageName ===
        "history"
    ) {

        renderHistory();

    }

}


function openPendingPage() {

    showPage(
        "pending"
    );

}


/* ==========================================================
   PENDING
========================================================== */

function getPendingAssignments() {

    return state.assignments.filter(
        item =>

            item.status ===
                "pending"

            ||

            item.status ===
                "processing"
    );

}


/* ==========================================================
   COUNTERS
========================================================== */

function updateCounters() {

    const pending =
        state.assignments.filter(
            item =>
                item.status ===
                "pending"
        ).length;


    const processing =
        state.assignments.filter(
            item =>
                item.status ===
                "processing"
        ).length;


    const completed =
        state.completed.length;


    document.getElementById(
        "pendingCount"
    ).textContent =
        pending;


    document.getElementById(
        "processingCount"
    ).textContent =
        processing;


    document.getElementById(
        "completedCount"
    ).textContent =
        completed;


    document.getElementById(
        "navPendingCount"
    ).textContent =
        pending;


    document.getElementById(
        "queueCount"
    ).textContent =
        pending + processing;

}


/* ==========================================================
   DASHBOARD
========================================================== */

function renderDashboard() {

    dashboardTable.innerHTML =
        "";


    const rows =
        getPendingAssignments()
            .slice(
                0,
                5
            );


    if (
        rows.length === 0
    ) {

        dashboardTable.innerHTML = `

            <tr>

                <td
                    colspan="5"
                    style="
                        text-align:center;
                        padding:30px;
                        color:#9ca3af;
                    "
                >
                    Aucune ligne à traiter.
                </td>

            </tr>

        `;

        return;

    }


    rows.forEach(
        item => {

            dashboardTable.insertAdjacentHTML(
                "beforeend",
                `

                <tr>

                    <td>
                        ${escapeHTML(item.line.siret)}
                    </td>

                    <td>
                        <strong>
                            ${escapeHTML(item.line.raisonSociale)}
                        </strong>
                    </td>

                    <td>
                        ${escapeHTML(item.line.typeFacture || "—")}
                    </td>

                    <td>
                        ${escapeHTML(item.line.dateLimite || "—")}
                    </td>

                    <td>

                        ${
                            item.status ===
                            "processing"

                            ? `
                                <span class="status processing-status">
                                    En cours
                                </span>
                              `

                            : `
                                <span class="status pending-status">
                                    À traiter
                                </span>
                              `
                        }

                    </td>

                </tr>

                `
            );

        }
    );

}


/* ==========================================================
   PENDING LIST
========================================================== */

function renderPendingList() {

    pendingList.innerHTML =
        "";


    const search =
        pendingSearch.value
            .trim()
            .toLowerCase();


    const items =
        getPendingAssignments()
            .filter(
                item => {

                    return (

                        item.line.siret
                            .toLowerCase()
                            .includes(
                                search
                            )

                        ||

                        item.line.raisonSociale
                            .toLowerCase()
                            .includes(
                                search
                            )

                    );

                }
            );


    if (
        items.length === 0
    ) {

        pendingList.innerHTML = `

            <div style="
                text-align:center;
                padding:35px;
                color:#9ca3af;
                font-size:11px;
            ">
                Aucune ligne à traiter.
            </div>

        `;

        return;

    }


    items.forEach(
        item => {

            const element =
                document.createElement(
                    "div"
                );


            element.className =
                "pending-item";


            if (
                selectedLineId ===
                item.id
            ) {

                element.classList.add(
                    "selected"
                );

            }


            element.innerHTML = `

                <div class="pending-item-top">

                    <span class="pending-company">

                        ${escapeHTML(
                            item.line.raisonSociale
                        )}

                    </span>


                    ${
                        item.status ===
                        "processing"

                        ? `
                            <span class="status processing-status">
                                En cours
                            </span>
                          `

                        : `
                            <span class="status pending-status">
                                À traiter
                            </span>
                          `
                    }

                </div>


                <div class="pending-siret">

                    SIRET :
                    ${escapeHTML(
                        item.line.siret
                    )}

                </div>


                <div class="pending-meta">

                    <span>
                        Facture :
                        ${escapeHTML(
                            item.line.typeFacture || "—"
                        )}
                    </span>

                    <span>
                        ${escapeHTML(
                            item.line.dateLimite || "—"
                        )}
                    </span>

                </div>

            `;


            element.addEventListener(
                "click",
                () => {

                    selectLine(
                        item.id
                    );

                }
            );


            pendingList.appendChild(
                element
            );

        }
    );

}


/* ==========================================================
   SELECT
========================================================== */

function selectLine(
    id
) {

    const item =
        state.assignments.find(
            row =>
                row.id === id
        );


    if (!item) {
        return;
    }


    if (
        state.activeTreatmentId &&
        state.activeTreatmentId !== id
    ) {

        showToast(
            "Une autre ligne est déjà en cours."
        );

        return;

    }


    selectedLineId =
        id;


    renderPendingList();

    displaySelectedLine(
        item
    );

}


