/* ==========================================================
   ASSIGNMENT TABLE
========================================================== */

function renderAssignmentTable() {

    const table =
        document.getElementById(
            "assignmentTable"
        );


    table.innerHTML = "";


    const search =
        document.getElementById(
            "assignmentSearch"
        )
        .value
        .trim()
        .toLowerCase();


    const filter =
        document.getElementById(
            "agentFilter"
        )
        .value;


    const filtered =
        state.lines.filter(
            item => {

                const matchesSearch =

                    item.line.siret
                        .toLowerCase()
                        .includes(search)

                    ||

                    item.line.raisonSociale
                        .toLowerCase()
                        .includes(search);


                let matchesFilter =
                    true;


                if (
                    filter ===
                    "unassigned"
                ) {

                    matchesFilter =
                        !item.assignedTo;

                }
                else if (filter) {

                    matchesFilter =
                        item.assignedTo ===
                        filter;

                }


                return (
                    matchesSearch &&
                    matchesFilter
                );

            }
        );


    if (
        filtered.length === 0
    ) {

        table.innerHTML = `

            <tr>

                <td
                    colspan="7"
                    style="
                        text-align:center;
                        padding:35px;
                        color:#9ca3af;
                    "
                >
                    Aucune ligne trouvée.
                </td>

            </tr>

        `;

        return;

    }


    filtered.forEach(
        item => {

            const checked =
                selectedLines.has(
                    item.id
                );


            const row =
                document.createElement(
                    "tr"
                );


            if (checked) {

                row.classList.add(
                    "selected-row"
                );

            }


            row.innerHTML = `

                <td>

                    <input
                        type="checkbox"
                        class="line-checkbox"
                        data-id="${escapeHTML(item.id)}"
                        ${checked ? "checked" : ""}
                    >

                </td>


                <td>
                    ${escapeHTML(item.line.siret)}
                </td>


                <td>
                    <strong>
                        ${escapeHTML(item.line.raisonSociale)}
                    </strong>
                </td>


                <td>
                    ${escapeHTML(item.line.typeFacture || "—")}
                </td>


                <td>
                    ${escapeHTML(item.line.dateLimite || "—")}
                </td>


                <td>

                    <select
                        class="agent-select"
                        data-line-id="${escapeHTML(item.id)}"
                    >

                        ${buildAgentOptions(
                            item.assignedTo
                        )}

                    </select>

                </td>


                <td>

                    ${
                        item.assignedTo

                        ? `
                            <span class="status assigned-status">
                                Affectée
                            </span>
                          `

                        : `
                            <span class="status unassigned-status">
                                Non affectée
                            </span>
                          `
                    }

                </td>

            `;


            table.appendChild(
                row
            );

        }
    );


    attachAssignmentEvents();

}


/* ==========================================================
   ROW EVENTS
========================================================== */

function attachAssignmentEvents() {

    document
        .querySelectorAll(
            ".line-checkbox"
        )
        .forEach(checkbox => {

            checkbox.addEventListener(
                "change",
                () => {

                    const id =
                        checkbox.dataset.id;


                    if (
                        checkbox.checked
                    ) {

                        selectedLines.add(
                            id
                        );

                    }
                    else {

                        selectedLines.delete(
                            id
                        );

                    }


                    updateSelectedCount();

                    renderAssignmentTable();

                }
            );

        });


    document
        .querySelectorAll(
            ".agent-select"
        )
        .forEach(select => {

            select.addEventListener(
                "change",
                () => {

                    assignLine(
                        select.dataset.lineId,
                        select.value
                    );

                }
            );

        });

}


/* ==========================================================
   AGENT OPTIONS
========================================================== */

function buildAgentOptions(
    selectedAgent
) {

    let html = `

        <option value="">
            Non affectée
        </option>

    `;


    state.agents.forEach(
        agent => {

            html += `

                <option
                    value="${escapeHTML(agent.id)}"
                    ${
                        selectedAgent ===
                        agent.id
                            ? "selected"
                            : ""
                    }
                >
                    ${escapeHTML(agent.name)}
                </option>

            `;

        }
    );


    return html;

}


/* ==========================================================
   ASSIGN ONE
========================================================== */

function assignLine(
    lineId,
    agentId
) {

    const line =
        state.lines.find(
            item =>
                item.id === lineId
        );


    if (!line) {
        return;
    }


    line.assignedTo =
        agentId || null;


    line.status =
        agentId
            ? "assigned"
            : "unassigned";


    state.validated =
        false;


    saveState();

    renderAll();

}


