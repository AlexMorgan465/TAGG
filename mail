    clearform
    loading = False
    RefreshListView
    StartClock
    Exit Sub
Failed:
    loading = False
    cmb_Ajouter.Enabled = False
    cmb_Terminer.Enabled = False
    MsgBox "Initialisation impossible : " & Err.Description, vbExclamation
End Sub

