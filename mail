/* ==========================================================
   BULK ASSIGN
========================================================== */

function assignSelectedLines() {

    const agentId =
        document.getElementById(
            "bulkAgent"
        ).value;


    if (!agentId) {

        showToast(
            "Sélectionnez un agent."
        );

        return;

    }


    selectedLines.forEach(
        lineId => {

            const line =
                state.lines.find(
                    item =>
                        item.id === lineId
                );


            if (!line) {
                return;
            }


            line.assignedTo =
                agentId;


            line.status =
                "assigned";

        }
    );


    selectedLines.clear();


    document.getElementById(
        "selectAll"
    ).checked =
        false;


    document.getElementById(
        "bulkAgent"
    ).value =
        "";


    state.validated =
        false;


    saveState();

    renderAll();

    updateSelectedCount();


    showToast(
        "Lignes affectées."
    );

}


