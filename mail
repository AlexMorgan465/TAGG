function sourceInfo() {

    return [

        [
            "Fichier",
            state.source.fileName
        ],

        [
            "CSP",
            state.source.nomCSP
        ],

        [
            "Contrat BAD",
            state.source.contratBAD
        ],

        [
            "IDT connexion",
            state.source.idtConnexion
        ],

        [
            "MDP CSP",
            state.source.mdpCSP
        ],

        [
            "N° Abonné CSP",
            state.source.numeroAbonneCSP
        ],

        [
            "IBAN",
            state.source.iban
        ]
    ];
}


function renderInfo(
    id,
    values
) {

    const container =
        document.getElementById(id);


    if (!container) return;


    container.innerHTML = "";


    values.forEach(
        ([label, value]) => {

            const div =
                document.createElement(
                    "div"
                );


            div.className =
                "info-item";


            div.innerHTML = `

                <span>
                    ${escapeHtml(label)}
                </span>

                <strong>
                    ${escapeHtml(
                        value || "—"
                    )}
                </strong>
            `;


            container.appendChild(
                div
            );
        }
    );
}


function cell(row, index) {

    if (
        index === -1 ||
        index === undefined
    ) {

        return "";
    }


    return String(
        row[index] || ""
    ).trim();
}


function normalize(value) {

    return String(value || "")
        .normalize("NFD")
        .replace(
            /[\u0300-\u036f]/g,
            ""
        )
        .toLowerCase()
        .replace(/\s+/g, " ")
        .trim();
}


function createId(
    siret,
    raison,
    index
) {

    return (
        "L"
        +
        index
        +
        "_"
        +
        String(
            siret || raison
        )
        .replace(
            /[^a-zA-Z0-9]/g,
            ""
        )
        .substring(0, 30)
    );
}


function addCell(row, value) {

    const td =
        document.createElement("td");

    td.textContent =
        value || "—";

    row.appendChild(td);
}


function setText(id, value) {

    const element =
        document.getElementById(id);


    if (element) {

        element.textContent =
            value || "";
    }
}


function escapeHtml(value) {

    const div =
        document.createElement("div");

    div.textContent =
        String(value || "");

    return div.innerHTML;
}



