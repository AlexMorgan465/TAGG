script.js

// People that exist the FIRST time the website is opened
const defaultPeople = [
    {
        name: "Amine",
        age: 22
    },
    {
        name: "Yassine",
        age: 24
    }
];


// Load saved people
let people = JSON.parse(localStorage.getItem("people"));


// If nothing has been saved yet,
// use our default people
if (!people) {
    people = defaultPeople;
    savePeople();
}


// Elements
const nameInput = document.getElementById("name");
const ageInput = document.getElementById("age");

const addBtn = document.getElementById("addBtn");
const clearBtn = document.getElementById("clearBtn");

const peopleList = document.getElementById("peopleList");
const peopleCount = document.getElementById("peopleCount");
const emptyMessage = document.getElementById("emptyMessage");


// SAVE
function savePeople() {

    localStorage.setItem(
        "people",
        JSON.stringify(people)
    );

}


// DISPLAY
function displayPeople() {

    peopleList.innerHTML = "";

    peopleCount.textContent = people.length;


    // Empty list
    if (people.length === 0) {

        emptyMessage.style.display = "block";

        return;

    }


    emptyMessage.style.display = "none";


    // Create each person
    people.forEach((person, index) => {

        const personDiv = document.createElement("div");

        personDiv.className = "person";


        personDiv.innerHTML = `

            <div class="person-info">

                <span class="person-name">
                    ${person.name}
                </span>

                <span class="person-age">
                    ${person.age} years old
                </span>

            </div>

            <button
                class="delete-btn"
                onclick="deletePerson(${index})"
            >
                Delete
            </button>

        `;


        peopleList.appendChild(personDiv);

    });

}


// ADD PERSON
function addPerson() {

    const name = nameInput.value.trim();

    const age = ageInput.value;


    // Validation
    if (name === "") {

        alert("Please enter a name.");

        nameInput.focus();

        return;

    }


    if (age === "" || age <= 0) {

        alert("Please enter a valid age.");

        ageInput.focus();

        return;

    }


    // Create person
    const newPerson = {

        name: name,

        age: Number(age)

    };


    // Add to array
    people.push(newPerson);


    // Save
    savePeople();


    // Refresh interface
    displayPeople();


    // Clear inputs
    nameInput.value = "";

    ageInput.value = "";


    nameInput.focus();

}


// DELETE
function deletePerson(index) {

    people.splice(index, 1);

    savePeople();

    displayPeople();

}


// CLEAR EVERYTHING
function clearPeople() {

    if (people.length === 0) {
        return;
    }


    const confirmation = confirm(
        "Are you sure you want to delete everyone?"
    );


    if (!confirmation) {
        return;
    }


    people = [];

    savePeople();

    displayPeople();

}


// BUTTON EVENTS
addBtn.addEventListener("click", addPerson);

clearBtn.addEventListener("click", clearPeople);


// Press ENTER to add
nameInput.addEventListener("keydown", function(event) {

    if (event.key === "Enter") {
        addPerson();
    }

});


ageInput.addEventListener("keydown", function(event) {

    if (event.key === "Enter") {
        addPerson();
    }

});


// Initial display
displayPeople();

Now test it

Your folder should look like:

PeopleList/
│
├── index.html
├── style.css
└── script.js

Double-click index.html.

You'll initially see Amine and Yassine. Add someone, for example:

Name: Ikram
Age: 22

Click Add Person.

Then close the webpage completely and open index.html again. Ikram should still be there. That's the important test: if she remains, localStorage is working.

After you confirm that works, we can make the interface much more advanced—search, edit people, profile pictures, phone/email fields, sorting, IDs, etc.
