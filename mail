/* ==========================================================
   IMPORT EXCEL
========================================================== */

function importExcelFile(file) {

    if (
        typeof XLSX === "undefined"
    ) {

        showToast(
            "La bibliothèque XLSX n'est pas chargée."
        );

        return;

    }


    const reader =
        new FileReader();


    reader.onload =
        event => {

            try {

                const data =
                    new Uint8Array(
                        event.target.result
                    );


                const workbook =
                    XLSX.read(
                        data,
                        {
                            type: "array",
                            cellDates: true
                        }
                    );


                /*
                    For V1 we use the first worksheet.
                */

                const firstSheetName =
                    workbook.SheetNames[0];


                const worksheet =
                    workbook.Sheets[
                        firstSheetName
                    ];


                /*
                    header: 1 gives us
                    a raw 2D array.
                */

                const matrix =
                    XLSX.utils.sheet_to_json(
                        worksheet,
                        {
                            header: 1,
                            defval: "",
                            raw: false
                        }
                    );


                processExcelData(
                    matrix,
                    file
                );

            }
            catch (error) {

                console.error(error);

                showToast(
                    "Impossible de lire ce fichier Excel."
                );

            }

        };


    reader.readAsArrayBuffer(
        file
    );

}


/* ==========================================================
   PROCESS EXCEL
========================================================== */

function processExcelData(
    matrix,
    file
) {

    const source =
        extractSourceInformation(
            matrix
        );


    const table =
        extractClientTable(
            matrix
        );


    if (
        table.lines.length === 0
    ) {

        showToast(
            "Aucune ligne client détectée."
        );

        return;

    }


    state.file = {

        name:
            file.name,

        size:
            file.size,

        importedAt:
            new Date()
                .toLocaleString(
                    "fr-FR"
                )

    };


    state.source =
        source;


    state.lines =
        table.lines;


    state.validated =
        false;


    saveState();


    renderAll();


    showImportResult();


    showToast(
        `${table.lines.length} ligne(s) détectée(s).`
    );

}


/* ==========================================================
   NORMALIZE TEXT
========================================================== */

function normalizeText(value) {

    return String(value ?? "")
        .normalize("NFD")
        .replace(
            /[\u0300-\u036f]/g,
            ""
        )
        .trim()
        .toLowerCase();

}


/* ==========================================================
   SOURCE INFORMATION
========================================================== */

function extractSourceInformation(
    matrix
) {

    const source = {

        nomCSP:
            findValueNearLabel(
                matrix,
                [
                    "coordonnees du csp",
                    "nom csp"
                ]
            ),

        contratBAD:
            findValueNearLabel(
                matrix,
                [
                    "contrat bad"
                ]
            ),

        idtConnexion:
            findValueNearLabel(
                matrix,
                [
                    "idt de connexion",
                    "idt connexion"
                ]
            ),

        mdpCSP:
            findValueNearLabel(
                matrix,
                [
                    "mdp csp"
                ]
            ),

        numeroAbonneCSP:
            findValueNearLabel(
                matrix,
                [
                    "n° abonne csp",
                    "n abonne csp",
                    "numero abonne csp"
                ]
            ),

        iban:
            findValueNearLabel(
                matrix,
                [
                    "iban de prelevement",
                    "iban prelevement"
                ]
            )

    };


    /*
        In the screenshot "CYBERG" appears
        above "Coordonnées du CSP".

        If nomCSP wasn't found by a label,
        try to retrieve a meaningful cell above
        the source-information area.
    */

    if (!source.nomCSP) {

        source.nomCSP =
            findCSPName(matrix);

    }


    return source;

}


/* ==========================================================
   FIND VALUE NEXT TO LABEL
========================================================== */

function findValueNearLabel(
    matrix,
    labels
) {

    const normalizedLabels =
        labels.map(
            normalizeText
        );


    for (
        let rowIndex = 0;
        rowIndex < matrix.length;
        rowIndex++
    ) {

        const row =
            matrix[rowIndex];


        for (
            let colIndex = 0;
            colIndex < row.length;
            colIndex++
        ) {

            const current =
                normalizeText(
                    row[colIndex]
                );


            const matched =
                normalizedLabels.some(
                    label =>
                        current === label ||
                        current.includes(label)
                );


            if (!matched) {
                continue;
            }


            /*
                Search right first.
            */

            for (
                let c =
                    colIndex + 1;

                c <
                    Math.min(
                        row.length,
                        colIndex + 5
                    );

                c++
            ) {

                const value =
                    String(
                        row[c] ?? ""
                    ).trim();


                if (value) {
                    return value;
                }

            }


            /*
                Then try directly below.
            */

            for (
                let r =
                    rowIndex + 1;

                r <
                    Math.min(
                        matrix.length,
                        rowIndex + 3
                    );

                r++
            ) {

                const value =
                    String(
                        matrix[r]?.[
                            colIndex
                        ] ?? ""
                    ).trim();


                if (value) {
                    return value;
                }

            }

        }

    }


    return "";

}


/* ==========================================================
   CSP NAME
========================================================== */

function findCSPName(matrix) {

    for (
        let rowIndex = 0;
        rowIndex < matrix.length;
        rowIndex++
    ) {

        const row =
            matrix[rowIndex];


        const hasCoordinateLabel =
            row.some(
                value =>
                    normalizeText(value)
                        .includes(
                            "coordonnees du csp"
                        )
            );


        if (!hasCoordinateLabel) {
            continue;
        }


        /*
            Look a few rows above.
        */

        for (
            let r =
                rowIndex - 1;

            r >=
                Math.max(
                    0,
                    rowIndex - 3
                );

            r--
        ) {

            for (
                const value
                of matrix[r]
            ) {

                const text =
                    String(
                        value ?? ""
                    ).trim();


                if (
                    text &&
                    text.length < 50
                ) {

                    return text;

                }

            }

        }

    }


    return "";

}


/* ==========================================================
   DETECT CLIENT TABLE
========================================================== */

function extractClientTable(
    matrix
) {

    let headerRowIndex =
        -1;


    let columns = {

        siret: -1,

        raisonSociale: -1,

        typeFacture: -1,

        dateLimite: -1,

        numeroAbonne: -1,

        identifiant: -1,

        mdp: -1,

        contratBAD: -1,

        rattachement: -1,

        commentaire: -1

    };


    /*
        Find row containing SIRET
        and Raison Sociale.
    */

    for (
        let r = 0;
        r < matrix.length;
        r++
    ) {

        const normalizedRow =
            matrix[r].map(
                normalizeText
            );


        const siretIndex =
            normalizedRow.findIndex(
                value =>
                    value.includes(
                        "siret"
                    )
            );


        const raisonIndex =
            normalizedRow.findIndex(
                value =>
                    value.includes(
                        "raison sociale"
                    )
            );


        if (
            siretIndex !== -1 &&
            raisonIndex !== -1
        ) {

            headerRowIndex = r;

            columns.siret =
                siretIndex;

            columns.raisonSociale =
                raisonIndex;


            columns.typeFacture =
                findColumn(
                    normalizedRow,
                    [
                        "type facture",
                        "factures en emission",
                        "emission"
                    ]
                );


            columns.dateLimite =
                findColumn(
                    normalizedRow,
                    [
                        "date limite"
                    ]
                );


            columns.numeroAbonne =
                findColumn(
                    normalizedRow,
                    [
                        "n°abonne e-factures",
                        "n abonne e-factures",
                        "abonne e-factures"
                    ]
                );


            columns.identifiant =
                findColumn(
                    normalizedRow,
                    [
                        "identifiant"
                    ]
                );


            columns.mdp =
                findColumn(
                    normalizedRow,
                    [
                        "mdp"
                    ]
                );


            columns.contratBAD =
                findColumn(
                    normalizedRow,
                    [
                        "contrat b@d",
                        "contrat bad"
                    ]
                );


            columns.rattachement =
                findColumn(
                    normalizedRow,
                    [
                        "rattachement"
                    ]
                );


            columns.commentaire =
                findColumn(
                    normalizedRow,
                    [
                        "commentaire"
                    ]
                );


            break;

        }

    }


    if (
        headerRowIndex === -1
    ) {

        return {
            headerRowIndex,
            columns,
            lines: []
        };

    }


    const lines = [];


    for (
        let r =
            headerRowIndex + 1;

        r < matrix.length;

        r++
    ) {

        const row =
            matrix[r];


        const siret =
            cellValue(
                row,
                columns.siret
            );


        const raison =
            cellValue(
                row,
                columns.raisonSociale
            );


        /*
            Empty row = stop after table area.
        */

        if (
            !siret &&
            !raison
        ) {

            continue;

        }


        /*
            Ignore garbage/non-client rows.
        */

        if (
            !siret ||
            !raison
        ) {

            continue;

        }


        lines.push({

            id:
                createLineId(
                    siret,
                    r
                ),

            excelRow:
                r + 1,

            line: {

                siret:
                    siret,

                raisonSociale:
                    raison,

                typeFacture:
                    cellValue(
                        row,
                        columns.typeFacture
                    ),

                dateLimite:
                    cellValue(
                        row,
                        columns.dateLimite
                    ),

                numeroAbonne:
                    cellValue(
                        row,
                        columns.numeroAbonne
                    ),

                identifiant:
                    cellValue(
                        row,
                        columns.identifiant
                    ),

                mdp:
                    cellValue(
                        row,
                        columns.mdp
                    ),

                contratBAD:
                    cellValue(
                        row,
                        columns.contratBAD
                    ),

                rattachement:
                    cellValue(
                        row,
                        columns.rattachement
                    ),

                commentaire:
                    cellValue(
                        row,
                        columns.commentaire
                    )

            },

            assignedTo:
                null,

            status:
                "unassigned"

        });

    }


    return {
        headerRowIndex,
        columns,
        lines
    };

}


/* ==========================================================
   FIND COLUMN
========================================================== */

function findColumn(
    normalizedRow,
    candidates
) {

    const normalizedCandidates =
        candidates.map(
            normalizeText
        );


    return normalizedRow.findIndex(
        cell => {

            return normalizedCandidates.some(
                candidate =>
                    cell === candidate ||
                    cell.includes(candidate)
            );

        }
    );

}


/* ==========================================================
   CELL
========================================================== */

function cellValue(
    row,
    index
) {

    if (
        index === -1 ||
        index == null
    ) {

        return "";

    }


    return String(
        row[index] ?? ""
    ).trim();

}


/* ==========================================================
   ID
========================================================== */

function createLineId(
    siret,
    rowIndex
) {

    return (
        "LINE-" +
        String(siret)
            .replace(
                /\s/g,
                ""
            ) +
        "-" +
        rowIndex
    );

}


