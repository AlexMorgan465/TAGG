function renderInformation(
    container,
    information
) {

    if (!container) {
        return;
    }


    container.innerHTML =
        "";


    information.forEach(
        ([label, value]) => {

            const element =
                document.createElement(
                    "div"
                );


            element.className =
                "info-item";


            const labelElement =
                document.createElement(
                    "span"
                );


            labelElement.className =
                "info-label";


            labelElement.textContent =
                label;


            const valueElement =
                document.createElement(
                    "span"
                );


            valueElement.className =
                "info-value";


            valueElement.textContent =
                value || "—";


            element.append(
                labelElement,
                valueElement
            );


            container.appendChild(
                element
            );

        }
    );

}


/* ============================================================
   IMPORT PAGE
============================================================ */

function renderImportPage() {

    const result =
        document.getElementById(
            "importResult"
        );


    if (
        state.lines.length ===
        0
    ) {

        result.classList.add(
            "hidden"
        );

        return;

    }


    result.classList.remove(
        "hidden"
    );


    document.getElementById(
        "importFileName"
    ).textContent =
        state.source.fileName ||
        "—";


    document.getElementById(
        "importedRowsCount"
    ).textContent =
        `${state.lines.length} ligne(s)`;


    renderInformation(
        document.getElementById(
            "sourceInformation"
        ),
        getSourceInformation()
    );


    const table =
        document.getElementById(
            "importPreviewTable"
        );


    table.innerHTML =
        "";


    state.lines.forEach(
        item => {

            table.insertAdjacentHTML(
                "beforeend",
                `

                <tr>

                    <td>
                        ${escapeHTML(item.line.siret)}
                    </td>

                    <td>
                        <strong>
                            ${escapeHTML(item.line.raisonSociale)}
                        </strong>
                    </td>

                    <td>
                        ${escapeHTML(item.line.typeFacture || "—")}
                    </td>

                    <td>
                        ${escapeHTML(item.line.numeroAbonne || "—")}
                    </td>

                    <td>
