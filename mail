* {
    box-sizing: border-box;
}

:root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --primary-soft: #eff6ff;

    --sidebar: #111827;
    --sidebar-hover: #1f2937;

    --background: #f5f7fb;
    --surface: #ffffff;

    --text: #111827;
    --muted: #6b7280;
    --border: #e5e7eb;

    --success: #16a34a;
    --success-soft: #f0fdf4;

    --warning: #ea580c;
    --warning-soft: #fff7ed;

    --danger: #dc2626;

    --radius: 12px;
}

body {
    margin: 0;
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--background);
    color: var(--text);
}

button,
input,
textarea {
    font-family: inherit;
}

button {
    cursor: pointer;
}


/* =========================
   APP
========================= */

.app {
    min-height: 100vh;
}


/* =========================
   SIDEBAR
========================= */

.sidebar {
    position: fixed;
    inset: 0 auto 0 0;

    width: 250px;

    display: flex;
    flex-direction: column;

    padding: 24px 16px;

    background: var(--sidebar);
    color: white;

    z-index: 100;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 0 8px 28px;
}

.brand-logo {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    border-radius: 11px;

    background: var(--primary);

    font-size: 13px;
    font-weight: 700;
}

.brand-text strong,
.brand-text span {
    display: block;
}

.brand-text strong {
    font-size: 14px;
}

.brand-text span {
    margin-top: 3px;
    font-size: 11px;
    color: #9ca3af;
}


/* NAV */

.navigation {
    flex: 1;
}

.nav-btn {
    position: relative;

    width: 100%;

    display: flex;
    align-items: center;
    gap: 12px;

    padding: 13px 14px;
    margin-bottom: 6px;

    border: 0;
    border-radius: 9px;

    background: transparent;
    color: #9ca3af;

    text-align: left;
    font-size: 13px;

    transition: 0.15s;
}

.nav-btn:hover {
    color: white;
    background: var(--sidebar-hover);
}

.nav-btn.active {
    color: white;
    background: var(--primary);
}

.nav-icon {
    width: 20px;
    text-align: center;
    font-size: 17px;
}

.nav-count {
    margin-left: auto;

    min-width: 23px;
    height: 23px;

    display: grid;
    place-items: center;

    padding: 0 7px;

    border-radius: 20px;

    background: #ef4444;
    color: white;

    font-size: 11px;
}


/* AGENT */

.agent-profile {
    display: flex;
    align-items: center;
    gap: 10px;

    padding: 18px 8px 0;

    border-top: 1px solid #374151;
}

.avatar,
.mini-avatar {
    display: grid;
    place-items: center;

    border-radius: 50%;

    font-weight: 700;
}

.avatar {
    width: 39px;
    height: 39px;

    background: #374151;

    font-size: 11px;
}

.agent-profile-text strong,
.agent-profile-text span {
    display: block;
}

.agent-profile-text strong {
    font-size: 12px;
}

.agent-profile-text span {
    margin-top: 3px;
    font-size: 11px;
    color: #9ca3af;
}


/* =========================
   MAIN
========================= */

.main {
    min-height: 100vh;

    margin-left: 250px;
    padding: 30px 38px 50px;
}


/* TOPBAR */

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 28px;
}

.topbar h1 {
    margin: 0;
    font-size: 25px;
}

.topbar > div > p {
    margin: 6px 0 0;

    color: var(--muted);
    font-size: 13px;
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

.date-box {
    padding: 10px 14px;

    border: 1px solid var(--border);
    border-radius: 9px;

    background: white;

    color: #4b5563;
    font-size: 12px;
}

.agent-mini {
    display: flex;
    align-items: center;
    gap: 9px;

    padding: 7px 12px 7px 7px;

    background: white;

    border: 1px solid var(--border);
    border-radius: 9px;
}

.mini-avatar {
    width: 32px;
    height: 32px;

    background: var(--primary-soft);
    color: var(--primary);

    font-size: 10px;
}

.agent-mini strong,
.agent-mini span {
    display: block;
}

.agent-mini strong {
    font-size: 11px;
}

.agent-mini span {
    margin-top: 2px;
    font-size: 10px;
    color: var(--muted);
}


/* =========================
   PAGE
========================= */

.page {
    display: none;
}

.page.active {
    display: block;
}


/* =========================
   DASHBOARD
========================= */

.welcome {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 25px 27px;
    margin-bottom: 20px;

    border-radius: var(--radius);

    background:
        linear-gradient(
            110deg,
            #eff6ff,
            #ffffff
        );

    border: 1px solid #dbeafe;
}

.eyebrow {
    display: block;

    margin-bottom: 7px;

    color: var(--primary);

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 1px;
}

.welcome h2 {
    margin: 0;
    font-size: 21px;
}

.welcome p {
    margin: 7px 0 0;

    color: var(--muted);
    font-size: 12px;
}


/* BUTTON */

.primary-btn {
    padding: 11px 16px;

    border: 0;
    border-radius: 8px;

    background: var(--primary);
    color: white;

    font-size: 12px;
    font-weight: 600;
}

.primary-btn:hover {
    background: var(--primary-dark);
}


/* STATS */

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 18px;

    margin-bottom: 20px;
}

.stat-card {
    display: flex;
    align-items: center;
    gap: 15px;

    padding: 20px;

    border: 1px solid var(--border);
    border-radius: var(--radius);

    background: white;
}

.stat-icon {
    width: 44px;
    height: 44px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    font-size: 19px;
}

.warning-icon {
    background: var(--warning-soft);
    color: var(--warning);
}

.active-icon {
    background: var(--primary-soft);
    color: var(--primary);
}

.success-icon {
    background: var(--success-soft);
    color: var(--success);
}

.stat-card span {
    display: block;

    margin-bottom: 4px;

    color: var(--muted);
    font-size: 11px;
}

.stat-card strong {
    font-size: 26px;
}


/* =========================
   CARD
========================= */

.card {
    margin-bottom: 18px;
    padding: 21px;

    background: white;

    border: 1px solid var(--border);
    border-radius: var(--radius);
}

.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 18px;
}

.card-header h3,
.section-heading h3 {
    margin: 0;
    font-size: 15px;
}

.card-header p,
.section-heading p {
    margin: 5px 0 0;

    color: var(--muted);
    font-size: 11px;
}

.text-btn {
    border: 0;
    background: transparent;

    color: var(--primary);

    font-size: 11px;
    font-weight: 600;
}


/* =========================
   TABLE
========================= */

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;

    border-collapse: collapse;

    font-size: 12px;
}

th {
    padding: 11px 12px;

    background: #f9fafb;

    border-bottom: 1px solid var(--border);

    color: var(--muted);

    font-size: 10px;
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;

    letter-spacing: 0.3px;
}

td {
    padding: 13px 12px;

    border-bottom: 1px solid #f1f3f5;
}

tbody tr:last-child td {
    border-bottom: 0;
}


/* STATUS */

.status {
    display: inline-flex;
    align-items: center;

    padding: 5px 9px;

    border-radius: 20px;

    font-size: 10px;
    font-weight: 600;
}

.pending-status {
    background: var(--warning-soft);
    color: var(--warning);
}

.processing-status {
    background: var(--primary-soft);
    color: var(--primary);
}

.completed-status {
    background: var(--success-soft);
    color: var(--success);
}


/* =========================
   WORKSPACE
========================= */

.workspace {
    display: grid;

    grid-template-columns:
        minmax(340px, 0.75fr)
        minmax(500px, 1.25fr);

    gap: 20px;

    align-items: start;
}

.queue-card {
    position: sticky;
    top: 20px;

    max-height: calc(100vh - 60px);

    overflow: hidden;

    display: flex;
    flex-direction: column;
}

.pill {
    min-width: 28px;
    height: 28px;

    display: grid;
    place-items: center;

    padding: 0 8px;

    border-radius: 20px;

    background: var(--primary-soft);
    color: var(--primary);

    font-size: 11px;
    font-weight: 700;
}

.queue-search {
    margin-bottom: 13px;
}

.queue-search input,
.history-search {
    width: 100%;

    padding: 10px 12px;

    border: 1px solid var(--border);
    border-radius: 8px;

    outline: none;

    background: #fafafa;

    font-size: 11px;
}

.queue-search input:focus,
.history-search:focus {
    border-color: var(--primary);
    background: white;
}

.pending-list {
    overflow-y: auto;

    display: flex;
    flex-direction: column;

    gap: 8px;

    padding-right: 3px;
}


/* PENDING ITEM */

.pending-item {
    padding: 14px;

    border: 1px solid var(--border);
    border-radius: 9px;

    cursor: pointer;

    transition: 0.15s;
}

.pending-item:hover {
    border-color: #93c5fd;
    background: #fafcff;
}

.pending-item.selected {
    border-color: var(--primary);
    background: var(--primary-soft);
}

.pending-item-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 10px;
}

.pending-company {
    font-size: 12px;
    font-weight: 650;
}

.pending-siret {
    margin-top: 6px;

    color: var(--muted);
    font-size: 10px;
}

.pending-meta {
    display: flex;
    justify-content: space-between;

    margin-top: 10px;
    padding-top: 9px;

    border-top: 1px solid #f1f3f5;

    color: var(--muted);
    font-size: 10px;
}


/* =========================
   EMPTY
========================= */

.empty-state {
    padding: 70px 30px;

    text-align: center;
}

.empty-state-icon {
    width: 50px;
    height: 50px;

    display: grid;
    place-items: center;

    margin: 0 auto 15px;

    border-radius: 50%;

    background: #f3f4f6;
    color: #9ca3af;

    font-size: 21px;
}

.empty-state h3 {
    margin: 0 0 7px;

    font-size: 15px;
}

.empty-state p {
    max-width: 310px;

    margin: auto;

    color: var(--muted);
    font-size: 11px;

    line-height: 1.6;
}

.hidden {
    display: none !important;
}


/* =========================
   SELECTED CLIENT
========================= */

.selected-client {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 15px;
    padding: 4px 3px;
}

.selected-client h2 {
    margin: 0;

    font-size: 20px;
}

.selected-siret {
    display: block;

    margin-top: 5px;

    color: var(--muted);
    font-size: 11px;
}


/* =========================
   INFORMATION
========================= */

.section-heading {
    display: flex;
    align-items: center;
    gap: 11px;

    margin-bottom: 18px;
}

.heading-icon {
    width: 37px;
    height: 37px;

    display: grid;
    place-items: center;

    border-radius: 8px;

    background: var(--primary-soft);
    color: var(--primary);
}

.info-grid {
