function readExcel(file) {

    const reader =
        new FileReader();


    reader.onload = event => {

        try {

            const workbook =
                XLSX.read(
                    event.target.result,
                    {
                        type: "array"
                    }
                );


            const sheet =
                workbook.Sheets[
                    workbook.SheetNames[0]
                ];


            const rows =
                XLSX.utils.sheet_to_json(
                    sheet,
                    {
                        header: 1,
                        defval: "",
                        raw: false
                    }
                );


            parseExcel(
                rows,
                file.name
            );

        } catch (error) {

            console.error(error);

            showToast(
                "Impossible de lire le fichier Excel."
            );
        }
    };


    reader.readAsArrayBuffer(
        file
    );
}



/* ============================================================
   PARSING
============================================================ */

function parseExcel(
    rows,
    fileName
) {

    const headerRow =
        findHeaderRow(rows);


    if (headerRow === -1) {

        showToast(
            "Tableau client introuvable."
        );

        return;
    }


    const headers =
        rows[headerRow];


    const columns = {

        siret:
            findColumn(
                headers,
                ["siret"]
            ),

        raison:
            findColumn(
                headers,
                ["raison sociale"]
            ),

        type:
            findColumn(
                headers,
                [
                    "factures en emission",
                    "e/r/e+r",
                    "type facture"
                ]
            ),

        numero:
            findColumn(
                headers,
                [
                    "abonne e-factures"
                ]
            ),

        identifiant:
            findColumn(
                headers,
                ["identifiant"]
            ),

        mdp:
            findColumn(
                headers,
                ["mdp"]
            ),

        contrat:
            findColumn(
                headers,
                [
                    "contrat b@d",
                    "contrat bad"
                ]
            ),

        rattachement:
            findColumn(
                headers,
                ["rattachement"]
            ),

        date:
            findColumn(
                headers,
                [
                    "date limite"
                ]
            ),

        commentaire:
            findColumn(
                headers,
                ["commentaire"]
            )
    };


    if (
        columns.siret === -1 ||
        columns.raison === -1
    ) {

        showToast(
            "Colonnes client introuvables."
        );

        return;
    }


    state.source = {

        fileName,

        nomCSP:
            findNear(
                rows,
                ["coordonnees du csp"],
                true
            ),

        contratBAD:
            findNear(
                rows,
                [
                    "contrat bad",
                    "contrat b@d"
                ]
            ),

        idtConnexion:
            findNear(
                rows,
                [
                    "idt de connexion"
                ]
            ),

        mdpCSP:
            findNear(
                rows,
                ["mdp csp"]
            ),

        numeroAbonneCSP:
            findNear(
                rows,
                [
                    "abonne csp"
                ]
            ),

        iban:
            findNear(
                rows,
                ["iban"]
            ),

        importedAt:
            new Date()
                .toLocaleString(
                    "fr-FR"
                )
    };


    /*
       Dans ton fichier, le nom CSP
       est généralement au-dessus
       de "Coordonnées du CSP".
    */

    state.source.nomCSP =
        detectCSPName(rows)
        ||
        state.source.nomCSP;


    const lines = [];


    for (
        let i = headerRow + 1;
        i < rows.length;
        i++
    ) {

        const row =
            rows[i];


        const siret =
            cell(
                row,
                columns.siret
            );


        const raison =
            cell(
                row,
                columns.raison
            );


        if (!siret && !raison) {
            continue;
        }


        lines.push({

            id:
                createId(
                    siret,
                    raison,
                    i
                ),

            assignedTo: null,

            selected: false,

            line: {

                siret,

                raisonSociale:
                    raison,

                typeFacture:
                    cell(
                        row,
                        columns.type
                    ),

                numeroAbonne:
                    cell(
                        row,
                        columns.numero
                    ),

                identifiant:
                    cell(
                        row,
                        columns.identifiant
                    ),

                mdp:
                    cell(
                        row,
                        columns.mdp
                    ),

                contratBAD:
                    cell(
                        row,
                        columns.contrat
                    ),

                rattachement:
                    cell(
                        row,
                        columns.rattachement
                    ),

                dateLimite:
                    cell(
                        row,
                        columns.date
                    ),

                commentaire:
                    cell(
                        row,
                        columns.commentaire
                    )
            }
        });
    }


    state.lines = lines;


    saveState();

    renderAll();


    showPage("import");


    showToast(
        `${lines.length} ligne(s) importée(s).`
    );
}



/* ============================================================
   DETECTION EXCEL
============================================================ */

function findHeaderRow(rows) {

    return rows.findIndex(row => {

        const values =
            row.map(normalize);


        return (
            values.some(
                value =>
                    value.includes("siret")
            )

            &&

            values.some(
                value =>
                    value.includes(
                        "raison sociale"
                    )
            )
        );
    });
}


function findColumn(
    headers,
    names
) {

    const values =
        headers.map(normalize);


    for (const name of names) {

        const n =
            normalize(name);


        const index =
            values.findIndex(
                value =>
                    value.includes(n)
            );


        if (index !== -1) {

            return index;
        }
    }


    return -1;
}


function findNear(
    rows,
    labels
) {

    for (const row of rows) {

        for (
            let c = 0;
            c < row.length;
            c++
        ) {

            const value =
                normalize(row[c]);


            if (
                labels.some(label =>
                    value.includes(
                        normalize(label)
                    )
                )
            ) {

                for (
                    let x = c + 1;
                    x < Math.min(
                        row.length,
                        c + 5
                    );
                    x++
                ) {

                    if (
                        String(
                            row[x] || ""
                        ).trim()
                    ) {

                        return String(
                            row[x]
                        ).trim();
                    }
                }
            }
        }
    }


    return "";
}


function detectCSPName(rows) {

    for (
        let r = 0;
        r < rows.length;
        r++
    ) {

        const row =
            rows[r];


        const found =
            row.some(value =>
                normalize(value)
                    .includes(
                        "coordonnees du csp"
                    )
            );


        if (!found) continue;


        for (
            let previous = r - 1;
            previous >=
                Math.max(0, r - 4);
            previous--
        ) {

            const value =
                rows[previous]
                    .find(
                        cell =>
                            String(
                                cell || ""
                            ).trim()
                    );


            if (value) {

                return String(
                    value
                ).trim();
            }
        }
    }


    return "";
}



/* ============================================================
   AFFECTATIONS
============================================================ */

function renderAssignments() {

    const table =
        document.getElementById(
            "assignmentTable"
        );

    if (!table) return;


    table.innerHTML = "";


    const search =
        normalize(
            document.getElementById(
                "assignmentSearch"
            )?.value
        );


    const filter =
        document.getElementById(
            "assignmentFilter"
        )?.value || "all";


    state.lines
        .filter(item => {

            const matchesSearch =
                normalize(
                    `${item.line.siret}
                     ${item.line.raisonSociale}`
                ).includes(search);


            const matchesFilter =
                filter === "all"

                ||

                (
                    filter === "assigned"
                    &&
                    item.assignedTo
                )

                ||

                (
                    filter === "unassigned"
                    &&
                    !item.assignedTo
                );


            return (
                matchesSearch &&
                matchesFilter
            );
        })

        .forEach(item => {

            const tr =
                document.createElement("tr");


            const checkboxCell =
                document.createElement("td");


            const checkbox =
                document.createElement(
                    "input"
                );

            checkbox.type =
                "checkbox";

            checkbox.checked =
                item.selected;


            checkbox.onchange = () => {

                item.selected =
                    checkbox.checked;

                saveState();
            };


            checkboxCell.appendChild(
                checkbox
            );


            tr.appendChild(
                checkboxCell
            );


            addCell(
                tr,
                item.line.siret
            );

            addCell(
                tr,
                item.line.raisonSociale
            );

            addCell(
                tr,
                item.line.typeFacture
            );

            addCell(
                tr,
                item.line.dateLimite
            );


            const agentCell =
                document.createElement("td");


            const select =
                document.createElement(
                    "select"
                );


            fillAgentSelect(
                select,
                item.assignedTo
            );


            select.onchange = () => {

                item.assignedTo =
                    select.value || null;

                saveState();

                renderAll();
            };


            agentCell.appendChild(
                select
            );


            tr.appendChild(
                agentCell
            );


            addCell(
                tr,
                item.assignedTo
                    ? "Affectée"
                    : "À affecter"
            );


            table.appendChild(tr);
        });
}


function fillAgentSelect(
    select,
    selected
) {

    select.innerHTML =
        `<option value="">
            Non affectée
        </option>`;


    state.agents.forEach(agent => {

        const option =
            document.createElement(
                "option"
            );


        option.value =
            agent.id;

        option.textContent =
            agent.name;


        if (
            agent.id === selected
        ) {

            option.selected = true;
        }


        select.appendChild(
            option
        );
    });
}


function assignSelected() {

    const agent =
        document.getElementById(
            "bulkAgentSelect"
        )?.value;


    if (!agent) {

        showToast(
            "Sélectionnez un agent."
        );

        return;
    }


    const selected =
        state.lines.filter(
            line => line.selected
        );


    if (!selected.length) {

        showToast(
            "Sélectionnez des lignes."
        );

        return;
    }


    selected.forEach(line => {

        line.assignedTo =
            agent;

        line.selected =
            false;
    });


    saveState();

    renderAll();


    showToast(
        `${selected.length} ligne(s) affectée(s).`
    );
}



/* ============================================================
   GENERATION affectations.js
============================================================ */

function validateAssignments() {

    if (!state.lines.length) {

        showToast(
            "Aucune ligne importée."
        );

        return;
    }


    const missing =
        state.lines.filter(
            line =>
                !line.assignedTo
        );


    if (missing.length) {

        showToast(
            `${missing.length} ligne(s) non affectée(s).`
        );

        return;
    }


    const data = {

        generatedAt:
            new Date()
                .toLocaleString(
                    "fr-FR"
                ),

        agents:
            state.agents.map(
                agent => ({

                    id:
                        agent.id,

                    name:
                        agent.name,

                    assignments:
                        state.lines

                            .filter(
                                item =>
                                    item.assignedTo ===
                                    agent.id
                            )

                            .map(
                                item => ({

                                    id:
                                        item.id,

                                    assignedAt:
                                        new Date()
                                            .toLocaleString(
                                                "fr-FR"
                                            ),

                                    source: {
                                        ...state.source
                                    },

                                    line: {
                                        ...item.line
                                    }
                                })
                            )
                })
            )
    };


    const javascript =
        "window.AFFECTATIONS = "
        +
        JSON.stringify(
            data,
            null,
            2
        )
        +
        ";\n";


    const blob =
        new Blob(
            [javascript],
            {
                type:
                    "text/javascript;charset=utf-8"
            }
        );


    const url =
        URL.createObjectURL(
            blob
        );


    const link =
        document.createElement("a");


    link.href =
        url;

    link.download =
        "affectations.js";


    document.body.appendChild(
        link
    );


    link.click();

    link.remove();


    setTimeout(
        () =>
            URL.revokeObjectURL(
                url
            ),
        1000
    );


    showToast(
        "✓ affectations.js généré."
    );
}



