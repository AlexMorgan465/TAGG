async function connectSharedFolder() {

    const button =
        document.getElementById("connectFolderButton");

    try {

        console.log("Ouverture du sélecteur...");

        const handle =
            await window.showDirectoryPicker({
                mode: "readwrite"
            });

        console.log("Dossier sélectionné :", handle);
        console.log("Nom :", handle.name);


        // Vérification permission
        let permission =
            await handle.queryPermission({
                mode: "readwrite"
            });

        console.log(
            "Permission actuelle :",
            permission
        );


        if (permission !== "granted") {

            permission =
                await handle.requestPermission({
                    mode: "readwrite"
                });

        }


        console.log(
            "Permission finale :",
            permission
        );


        if (permission !== "granted") {

            throw new Error(
                "Permission d'écriture refusée."
            );

        }


        // Test réel : accès/création du dossier data
        const dataFolder =
            await handle.getDirectoryHandle(
                "data",
                {
                    create: true
                }
            );


        // Test réel : accès/création de data/agents
        await dataFolder.getDirectoryHandle(
            "agents",
            {
                create: true
            }
        );


        // Seulement maintenant on considère
        // le dossier comme connecté
        sharedFolderHandle = handle;


        button.textContent =
            "✓ Dossier connecté";


        button.classList.add(
            "connected"
        );


        showToast(
            "✓ Dossier connecté avec succès."
        );


        console.log(
            "Connexion réussie :",
            handle.name
        );

    }
    catch (error) {

        sharedFolderHandle = null;


        button.textContent =
            "⚠ Connexion échouée";


        console.error(
            "ERREUR CONNEXION DOSSIER :",
            error
        );


        showToast(
            `${error.name}: ${error.message}`
        );

    }

}
