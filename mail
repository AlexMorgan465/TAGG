Private Sub cmb_Terminer_Click()
    Dim ws As Worksheet, wx As Worksheet, r As Long, target As Long, finished As Date
    Dim oldTemp As Variant, oldExtract As Variant, writing As Boolean, detail As String
    On Error GoTo Failed
    If currentRow < 2 Then
        MsgBox "Selectionnez d'abord un dossier dans la liste.", vbExclamation
        Exit Sub
    End If
    If cmbActividadNuevo.ListIndex < 0 Or cmbMotivoNuevo.ListIndex < 0 Then
        MsgBox "Veuillez remplir GODIGO ACTIVIDAD et MOTIVO REASIGNADO.", vbExclamation
        Exit Sub
    End If
    Set ws = GetTempSheet()
    Set wx = GetExtractSheet()
    EnsureHeaders ws
    EnsureHeaders wx
    If txtReferenciaNuevo.Value <> CStr(ws.Cells(currentRow, 3).Value) Or cmbCanalNuevo.Value <> CStr(ws.Cells(currentRow, 4).Value) Then
        MsgBox "L'Etape 1 est deja enregistree. Reselectionnez le dossier pour retrouver ses valeurs.", vbExclamation
        Exit Sub
    End If
    For r = 2 To LastRow(wx)
        If CStr(wx.Cells(r, 3).Value) = CStr(ws.Cells(currentRow, 3).Value) Then
            If wx.Cells(r, 8).Value2 = ws.Cells(currentRow, 8).Value2 And CStr(wx.Cells(r, 1).Value) = CStr(ws.Cells(currentRow, 1).Value) Then
                target = r
                Exit For
            End If
        End If
    Next r
    If target = 0 Then
        MsgBox "La ligne correspondante est absente de l'extraction. Le dossier n'a pas ete modifie.", vbExclamation
        Exit Sub
    End If
    oldTemp = ws.Range(ws.Cells(currentRow, 1), ws.Cells(currentRow, 10)).Formula
    oldExtract = wx.Range(wx.Cells(target, 1), wx.Cells(target, 10)).Formula
    finished = Now
    If IsDate(ws.Cells(currentRow, 9).Value) Then finished = CDate(ws.Cells(currentRow, 9).Value)
    writing = True
    WriteFinish ws, currentRow, finished
    WriteFinish wx, target, finished
    writing = False
    clearform
    RefreshListView
    MsgBox "Etape 2 enregistree.", vbInformation
    Exit Sub
Failed:
    detail = Err.Description
    If writing Then
        On Error Resume Next
        ws.Range(ws.Cells(currentRow, 1), ws.Cells(currentRow, 10)).Formula = oldTemp
        wx.Range(wx.Cells(target, 1), wx.Cells(target, 10)).Formula = oldExtract
        On Error GoTo 0
    End If
    MsgBox "Enregistrement impossible : " & detail, vbExclamation
End Sub

Private Sub WriteFinish(ByVal ws As Worksheet, ByVal r As Long, ByVal finished As Date)
    Dim durationCol As Long
    durationCol = 10
    ws.Cells(r, 9).Value = finished
    ws.Cells(r, durationCol).Value = finished - CDate(ws.Cells(r, 8).Value)
    ws.Cells(r, durationCol).NumberFormat = "[h]:mm:ss"
    ws.Cells(r, 5).Value = cmbActividadNuevo.Value
    ws.Cells(r, 6).Value = cmbMotivoNuevo.Value
    ws.Cells(r, 7).NumberFormat = "@"
    ws.Cells(r, 7).Value = txtCommentaireNuevo.Value
End Sub

