End Sub

Sub LoadSelectedData()
    Dim ws As Worksheet
    currentRow = 0
    If rowMap Is Nothing Then Exit Sub
    If vue.ListIndex <= 0 Then Exit Sub
    Set ws = GetTempSheet()
    currentRow = CLng(rowMap(vue.ListIndex + 1))
    txtFechaNuevo.Value = Format$(ws.Cells(currentRow, 2).Value, "dd/mm/yyyy")
    txtReferenciaNuevo.Value = CStr(ws.Cells(currentRow, 3).Value)
    cmbCanalNuevo.Value = CStr(ws.Cells(currentRow, 4).Value)
    cmbActividadNuevo.Value = CStr(ws.Cells(currentRow, 5).Value)
    cmbMotivoNuevo.Value = CStr(ws.Cells(currentRow, 6).Value)
    txtCommentaireNuevo.Value = CStr(ws.Cells(currentRow, 7).Value)
End Sub

