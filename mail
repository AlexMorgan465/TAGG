/* ============================================================
   VALIDATE ASSIGNMENTS
============================================================ */

async function validateAssignments() {

    if (
        state.lines.length ===
        0
    ) {

        showToast(
            "Aucune ligne à envoyer."
        );

        return;

    }


    const unassigned =
        state.lines.filter(
            line =>
                !line.assignedTo
        );


    if (
        unassigned.length >
        0
    ) {

        showToast(
            `${unassigned.length} ligne(s) ne sont pas encore affectée(s).`
        );

        return;

    }


    if (
        !sharedFolderHandle
    ) {

        showToast(
            "Connectez d'abord le dossier GestionTraitement."
        );

        return;

    }


    const button =
        document.getElementById(
            "validateAssignmentsButton"
        );


    const previousText =
        button.textContent;


    button.disabled =
        true;


    button.textContent =
        "Envoi en cours...";


    try {

        const success =
            await writeAgentFiles();


        if (
            !success
        ) {

            return;

        }


        state.validated =
            true;


        saveState();


        showToast(
            "✓ Affectations envoyées aux agents."
        );

    }
    finally {

        button.disabled =
            false;


        button.textContent =
            previousText;

    }

}


/* ============================================================
   WRITE AGENT FILES
============================================================ */

async function writeAgentFiles() {

    try {

        /*
            User selected:

            GestionTraitement/

            We create/find:

            GestionTraitement/data/
        */

        const dataFolder =
            await sharedFolderHandle
                .getDirectoryHandle(
                    "data",
                    {
                        create: true
                    }
                );


        /*
            Then:

            GestionTraitement/data/agents/
        */

        const agentsFolder =
            await dataFolder
                .getDirectoryHandle(
                    "agents",
                    {
                        create: true
                    }
                );


        /*
            IMPORTANT:

            Generate one file for EVERY agent.

            Even agents with zero assignments receive
            an empty file.

            This prevents old assignments from remaining
            visible after reassignment.
        */

        for (
            const agent
            of state.agents
        ) {

            const assignedLines =
                state.lines.filter(
                    item =>
                        item.assignedTo ===
                        agent.id
                );


            const assignments =
                assignedLines.map(
                    item => ({

                        id:
                            item.id,

                        assignedAt:
                            new Date()
                                .toLocaleString(
                                    "fr-FR"
                                ),

                        source: {

                            fileName:
                                state.source.fileName,

                            nomCSP:
                                state.source.nomCSP,

                            contratBAD:
                                state.source.contratBAD,

                            idtConnexion:
                                state.source.idtConnexion,

                            mdpCSP:
                                state.source.mdpCSP,

                            numeroAbonneCSP:
                                state.source.numeroAbonneCSP,

                            iban:
                                state.source.iban

                        },

                        line: {

                            ...item.line

                        },

                        status:
                            "pending"

                    })
                );


            const agentData = {

                agent:
                    agent.id,

                agentName:
                    agent.name,

                sourceFile:
                    state.source.fileName,

                updatedAt:
                    new Date()
                        .toLocaleString(
                            "fr-FR"
                        ),

                assignments:
                    assignments

            };


            /*
                JS instead of JSON because agent.html
                can be opened directly from file://
            */

            const content =

                "window.AGENT_DATA = "

                +

                JSON.stringify(
                    agentData,
                    null,
                    2
                )

                +

                ";\n";


            const fileHandle =
                await agentsFolder
                    .getFileHandle(
                        `${sanitizeFileName(agent.id)}.js`,
                        {
                            create: true
                        }
                    );


            const writable =
                await fileHandle
                    .createWritable();


            await writable.write(
                content
            );


            await writable.close();

        }


        return true;

    }
    catch (error) {

        console.error(
            "Erreur écriture agents:",
            error
        );


        showToast(
            "Impossible d'écrire les fichiers agents."
        );


        return false;

    }

}


