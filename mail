Private Sub CompactLayout(ByVal step1 As Object, ByVal step2 As Object)
    Dim ctl As Object, bottom As Single, buttonTop As Single
    ' Les cadres et la liste ont une hauteur exacte, pas un minimum.
    ' Les anciens controles masques ne determinent plus la hauteur.
    ' Ne pas reafficher ni superposer l'ancien bouton Terminer.
    btnTerminerNuevo.Top = txtCommentaireNuevo.Top + txtCommentaireNuevo.Height + 8
    btnTerminerNuevo.Left = step2.Width - btnTerminerNuevo.Width - 12
    btnTerminerNuevo.ZOrder 0
    step2.Height = btnTerminerNuevo.Top + btnTerminerNuevo.Height + 10
    bottom = step2.Top + step2.Height
    vue.Height = bottom - vue.Top
    ' Boutons de pied de formulaire, dont Sauvegarder.
    buttonTop = bottom + 6
    For Each ctl In Me.Controls
        If TypeName(ctl) = "CommandButton" Then
            If ctl.Visible And ctl.Top >= bottom Then
                ctl.Top = buttonTop
                ctl.Height = 22
            End If
        End If
    Next ctl
    bottom = buttonTop + 30
    Me.ScrollTop = 0
    Me.Height = bottom + (Me.Height - Me.InsideHeight)
    If Me.Height > Application.UsableHeight Then Me.Height = Application.UsableHeight
    Me.ScrollHeight = bottom
    If bottom > Me.InsideHeight Then
        Me.ScrollBars = fmScrollBarsVertical
    Else
        Me.ScrollBars = fmScrollBarsNone
    End If
End Sub

Private Sub UserForm_Initialize()
    On Error GoTo Failed
    loading = True
    BuildFields
    PrepareSheet GetTempSheet()
    PrepareSheet GetExtractSheet()
    agent.Value = "Bonjour " & Application.UserName
    clearform
    loading = False
    RefreshListView
    StartClock
    Exit Sub
Failed:
    loading = False
    cmb_Ajouter.Enabled = False
    cmb_Terminer.Enabled = False
    If Not btnTerminerNuevo Is Nothing Then btnTerminerNuevo.Enabled = False
    MsgBox "Initialisation impossible : " & Err.Description, vbExclamation
End Sub

Private Sub UserForm_Terminate()
    StopClock
End Sub

Private Sub UserForm_Activate()
    Me.StartUpPosition = 0
    Me.Left = Application.Left + (Application.Width - Me.Width) / 2
    Me.Top = Application.Top + (Application.Height - Me.Height) / 2
End Sub

Sub clearform()
