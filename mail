/* ==========================================================
   VALIDATION
========================================================== */

function updateAssignmentValidation() {

    const button =
        document.getElementById(
            "validateAssignmentsButton"
        );


    const message =
        document.getElementById(
            "validationMessage"
        );


    if (
        state.lines.length === 0
    ) {

        button.disabled =
            true;


        message.textContent =
            "Aucune ligne à valider.";

        return;

    }


    const unassigned =
        state.lines.filter(
            line =>
                !line.assignedTo
        ).length;


    if (
        unassigned > 0
    ) {

        button.disabled =
            true;


        message.textContent =
            `${unassigned} ligne(s) restent à affecter.`;

    }
    else {

        button.disabled =
            false;


        message.textContent =
            "Toutes les lignes sont affectées.";

    }

}


/* ==========================================================
   VALIDATE ASSIGNMENTS
========================================================== */

function validateAssignments() {

    const unassigned =
        state.lines.some(
            line =>
                !line.assignedTo
        );


    if (unassigned) {

        showToast(
            "Certaines lignes ne sont pas affectées."
        );

        return;

    }


    state.validated =
        true;


    saveState();


    /*
        IMPORTANT:

        Next version:
        this is where we will create/update
        the data for each agent in the shared folder.

        Example:

        HAMDANMO -> lines 1, 3, 7
        YASSINE  -> lines 2, 5
        SARA     -> lines 4, 6
    */


    showToast(
        "Affectations validées."
    );

}


/* ==========================================================
   AGENTS
========================================================== */

function addAgent() {

    const input =
        document.getElementById(
            "newAgentName"
        );


    const name =
        input.value
            .trim()
            .toUpperCase();


    if (!name) {

        showToast(
            "Saisissez le nom de l'agent."
        );

        return;

    }


    const id =
        createAgentId(
            name
        );


    const exists =
        state.agents.some(
            agent =>
                agent.id === id
        );


    if (exists) {

        showToast(
            "Cet agent existe déjà."
        );

        return;

    }


    state.agents.push({

        id,
        name

    });


    input.value =
        "";


    saveState();

    renderAll();


    showToast(
        `${name} ajouté.`
    );

}


/* ==========================================================
   REMOVE AGENT
========================================================== */

function removeAgent(
    agentId
) {

    const agent =
        getAgent(
            agentId
        );


    if (!agent) {
        return;
    }


    const assignedLines =
        state.lines.filter(
            line =>
                line.assignedTo ===
                agentId
        );


    if (
        assignedLines.length > 0
    ) {

        const confirmation =
            confirm(

                `${agent.name} possède ${assignedLines.length} ligne(s) affectée(s).\n\n` +

                `Les lignes redeviendront non affectées.\n\n` +

                `Continuer ?`

            );


        if (!confirmation) {
            return;
        }


        assignedLines.forEach(
            line => {

                line.assignedTo =
                    null;

                line.status =
                    "unassigned";

            }
        );

    }


    state.agents =
        state.agents.filter(
            item =>
                item.id !== agentId
        );


    saveState();

    renderAll();


    showToast(
        "Agent supprimé."
    );

}


