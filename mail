$ErrorActionPreference = "Stop"

$port = 8080
$baseUrl = "http://+:$port/"

$scriptFolder = Split-Path -Parent $MyInvocation.MyCommand.Path
$dataFolder = Join-Path $scriptFolder "data"
$dbFile = Join-Path $dataFolder "database.json"

if (!(Test-Path $dataFolder)) {
    New-Item -ItemType Directory -Path $dataFolder | Out-Null
}

if (!(Test-Path $dbFile)) {
@"
{
    "assignments": [],
    "treatments": []
}
"@ | Set-Content -Path $dbFile -Encoding UTF8
}

function Read-Database {
    $content = Get-Content $dbFile -Raw -Encoding UTF8

    if ([string]::IsNullOrWhiteSpace($content)) {
        return @{
            assignments = @()
            treatments  = @()
        }
    }

    return $content | ConvertFrom-Json
}

function Write-Database($db) {
    $json = $db | ConvertTo-Json -Depth 20
    $json | Set-Content -Path $dbFile -Encoding UTF8
}

function Send-Json {
    param(
        $Response,
        $Data,
        [int]$StatusCode = 200
    )

    $json = $Data | ConvertTo-Json -Depth 20
    $bytes = [System.Text.Encoding]::UTF8.GetBytes($json)

    $Response.StatusCode = $StatusCode
    $Response.ContentType = "application/json; charset=utf-8"
    $Response.Headers.Add("Access-Control-Allow-Origin", "*")
    $Response.Headers.Add("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
    $Response.Headers.Add("Access-Control-Allow-Headers", "Content-Type")
    $Response.ContentLength64 = $bytes.Length

    $Response.OutputStream.Write($bytes, 0, $bytes.Length)
    $Response.OutputStream.Close()
}

function Read-Body {
    param($Request)

    $reader = New-Object System.IO.StreamReader(
        $Request.InputStream,
        $Request.ContentEncoding
    )

    $body = $reader.ReadToEnd()
    $reader.Close()

    if ([string]::IsNullOrWhiteSpace($body)) {
        return $null
    }

    return $body | ConvertFrom-Json
}

$listener = New-Object System.Net.HttpListener
$listener.Prefixes.Add($baseUrl)

try {
    $listener.Start()
}
catch {
    Write-Host ""
    Write-Host "Impossible de demarrer le serveur." -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Red
    Write-Host ""
    Write-Host "Essaie PowerShell ISE en tant qu'administrateur." -ForegroundColor Yellow
    Read-Host "Entree pour fermer"
    exit
}

Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "   PEOPLELIST - SERVEUR DEMARRE" -ForegroundColor Green
Write-Host "============================================" -ForegroundColor Cyan
Write-Host ""
Write-Host "Port : $port"
Write-Host "Base : $dbFile"
Write-Host ""
Write-Host "Ne ferme pas cette fenetre pendant le test." -ForegroundColor Yellow
Write-Host ""

while ($listener.IsListening) {

    try {
        $context = $listener.GetContext()

        $request = $context.Request
        $response = $context.Response

        if ($request.HttpMethod -eq "OPTIONS") {
            $response.StatusCode = 204
            $response.Headers.Add("Access-Control-Allow-Origin", "*")
            $response.Headers.Add("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
            $response.Headers.Add("Access-Control-Allow-Headers", "Content-Type")
            $response.Close()
            continue
        }

        $path = $request.Url.AbsolutePath.TrimEnd("/")

        Write-Host "$(Get-Date -Format 'HH:mm:ss') $($request.HttpMethod) $path"

        # ================================
        # TEST SERVEUR
        # ================================

        if ($path -eq "/api/test") {

            Send-Json $response @{
                success = $true
                message = "Backend PowerShell operationnel"
                serverTime = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
            }

            continue
        }

        # ================================
        # LISTE DES AFFECTATIONS
        # ================================

        if (
            $path -eq "/api/assignments" -and
            $request.HttpMethod -eq "GET"
        ) {

            $db = Read-Database
            Send-Json $response $db.assignments
            continue
        }

        # ================================
        # CREER UNE AFFECTATION
        # ================================

        if (
            $path -eq "/api/assignments" -and
            $request.HttpMethod -eq "POST"
        ) {

            $body = Read-Body $request
            $db = Read-Database

            $assignment = @{
                id = [guid]::NewGuid().ToString()
                agent = $body.agent
                siret = $body.siret
                raisonSociale = $body.raisonSociale
                typeFacture = $body.typeFacture
                dateLimite = $body.dateLimite
                commentaire = $body.commentaire
                status = "AFFECTEE"
                assignedAt = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
            }

            $db.assignments = @($db.assignments) + $assignment

            Write-Database $db

            Send-Json $response @{
                success = $true
                assignment = $assignment
            }

            continue
        }

        # ================================
        # TRAITEMENTS
        # ================================

        if (
            $path -eq "/api/treatments" -and
            $request.HttpMethod -eq "GET"
        ) {

            $db = Read-Database
            Send-Json $response $db.treatments
            continue
        }

        # ================================
        # TERMINER UN TRAITEMENT
        # ================================

        if (
            $path -eq "/api/treatments" -and
            $request.HttpMethod -eq "POST"
        ) {

            $body = Read-Body $request
            $db = Read-Database

            $treatment = @{
                id = [guid]::NewGuid().ToString()
                assignmentId = $body.assignmentId
                agent = $body.agent
                siret = $body.siret
                raisonSociale = $body.raisonSociale

                numeroAbonne = $body.numeroAbonne
                idt = $body.idt
                mdp = $body.mdp
                contratBAD = $body.contratBAD
                csp = $body.csp
                commentaire = $body.commentaire

                status = "A_VERIFIER"
                completedAt = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
            }

            $db.treatments = @($db.treatments) + $treatment

            foreach ($assignment in $db.assignments) {

                if ($assignment.id -eq $body.assignmentId) {
                    $assignment.status = "TRAITEE"
                }
            }

            Write-Database $db

            Send-Json $response @{
                success = $true
                treatment = $treatment
            }

            continue
        }

        # ================================
        # VALIDATION / CORRECTION
        # ================================

        if (
            $path -eq "/api/treatment-status" -and
            $request.HttpMethod -eq "POST"
        ) {

            $body = Read-Body $request
            $db = Read-Database

            foreach ($treatment in $db.treatments) {

                if ($treatment.id -eq $body.id) {
                    $treatment.status = $body.status
                }
            }

            Write-Database $db

            Send-Json $response @{
                success = $true
            }

            continue
        }

        Send-Json $response @{
            success = $false
            message = "Route introuvable"
        } 404
    }
    catch {

        Write-Host $_.Exception.Message -ForegroundColor Red

        try {
            Send-Json $response @{
                success = $false
                message = $_.Exception.Message
            } 500
        }
        catch {}
    }
}

