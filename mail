' Export des nouveaux dossiers de l'extraction vers un fichier choisi.
' Les anciennes donnees et les lignes d'extraction ne sont pas effacees.
Private Function CsvValue(ByVal value As String) As String
    CsvValue = """" & Replace(value, """", """""") & """"
End Function

Private Sub cmb_Sauvegarder_Click()
    Dim path As Variant, ws As Worksheet, sheetName As Variant, r As Long, j As Long
    Dim content As String, line As String, h As Variant, count As Long, stream As Object
    On Error GoTo Failed
    h = Headers()
    content = "Collaborateur;" & Join(h, ";") & ";DEBUT;FIN" & vbCrLf
    For Each sheetName In Array("extraction")
        Set ws = ThisWorkbook.Worksheets(CStr(sheetName))
        For r = 2 To LastRow(ws)
            If IsDate(ws.Cells(r, 2).Value) Then
                line = CsvValue(CStr(ws.Cells(r, 1).Value))
                line = line & ";" & CsvValue(Format$(ws.Cells(r, 2).Value, "dd/mm/yyyy"))
                For j = 3 To 7
                    line = line & ";" & CsvValue(CStr(ws.Cells(r, j).Value))
                Next j
                For j = 8 To 9
                    If IsDate(ws.Cells(r, j).Value) Then
                        line = line & ";" & CsvValue(Format$(ws.Cells(r, j).Value, "yyyy-mm-dd hh:nn:ss"))
                    Else
                        line = line & ";" & CsvValue("")
                    End If
                Next j
                content = content & line & vbCrLf
                count = count + 1
            End If
        Next r
    Next sheetName
    If count = 0 Then
        MsgBox "Aucun nouveau dossier a exporter.", vbInformation
        Exit Sub
    End If
    path = Application.GetSaveAsFilename(InitialFileName:="Cofidis_" & Format$(Now, "yyyymmdd_hhnnss") & ".csv", FileFilter:="CSV (*.csv),*.csv")
    If VarType(path) = vbBoolean Then Exit Sub
    If LCase$(Right$(CStr(path), 4)) <> ".csv" Then path = CStr(path) & ".csv"
    If Len(Dir$(CStr(path))) > 0 Then
        If MsgBox("Remplacer ce fichier CSV ?", vbYesNo + vbQuestion) <> vbYes Then Exit Sub
    End If
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "utf-8"
    stream.Open
    stream.WriteText content
    stream.SaveToFile CStr(path), 2
    stream.Close
    MsgBox CStr(count) & " dossier(s) exporte(s). Les donnees du classeur sont conservees.", vbInformation
    Exit Sub
Failed:
    MsgBox "Export impossible : " & Err.Description, vbExclamation
    On Error Resume Next
    If Not stream Is Nothing Then stream.Close
End Sub
