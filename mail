function openImportDialog() {

    const input =
        document.getElementById(
            "excelInput"
        );

    if (input) {
        input.click();
    }
}


function initializeExcelImport() {

    const input =
        document.getElementById(
            "excelInput"
        );

    if (!input) {
        return;
    }


    input.addEventListener(
        "change",
        event => {

            const file =
                event.target.files[0];

            if (!file) {
                return;
            }

            importExcelFile(file);

            event.target.value = "";
        }
    );
}


function importExcelFile(file) {

    if (typeof XLSX === "undefined") {

        showToast(
            "SheetJS n'est pas disponible."
        );

        return;
    }


    const reader =
        new FileReader();


    reader.onload = event => {

        try {

            const data =
                new Uint8Array(
                    event.target.result
                );


            const workbook =
                XLSX.read(
                    data,
                    {
                        type: "array",
                        cellDates: true,
                        cellText: true
                    }
                );


            if (
                workbook.SheetNames.length === 0
            ) {

                showToast(
                    "Le fichier Excel est vide."
                );

                return;
            }


            const sheet =
                workbook.Sheets[
                    workbook.SheetNames[0]
                ];


            const rows =
                XLSX.utils.sheet_to_json(
                    sheet,
                    {
                        header: 1,
                        defval: "",
                        raw: false,
                        blankrows: false
                    }
                );


            processExcelData(
                rows,
                file.name
            );

        } catch (error) {

            console.error(
                "Erreur Excel :",
                error
            );

            showToast(
                "Impossible de lire le fichier Excel."
            );
        }
    };


    reader.readAsArrayBuffer(file);
}


/* ============================================================
   NORMALISATION
============================================================ */

function normalizeText(value) {

    return String(value ?? "")
        .normalize("NFD")
        .replace(
            /[\u0300-\u036f]/g,
            ""
        )
        .replace(/\s+/g, " ")
        .trim()
        .toLowerCase();
}


function cellValue(row, index) {

    if (
        index === -1 ||
        index === undefined
    ) {
        return "";
    }

    return String(
        row[index] ?? ""
    ).trim();
}


function cleanSiret(value) {

    return String(value ?? "")
        .replace(/\s+/g, "")
        .trim();
}


/* ============================================================
   RECHERCHE VALEUR
============================================================ */

function findValueNearLabel(
    rows,
    possibleLabels
) {

    const labels =
        possibleLabels.map(
            normalizeText
        );


    for (
        let r = 0;
        r < rows.length;
        r++
    ) {

        const row = rows[r];


        for (
            let c = 0;
            c < row.length;
            c++
        ) {

            const current =
                normalizeText(row[c]);


            if (!current) {
                continue;
            }


            const found =
                labels.some(label =>
                    current === label ||
                    current.includes(label)
                );


            if (!found) {
                continue;
            }


            /*
                Chercher à droite.
            */

            for (
                let offset = 1;
                offset <= 4;
                offset++
            ) {

                const value =
                    row[c + offset];

                if (
                    value !== undefined &&
                    String(value).trim() !== ""
                ) {

                    return String(value).trim();
                }
            }


            /*
                Chercher ligne suivante.
            */

            if (rows[r + 1]) {

                for (
                    let offset = 0;
                    offset <= 4;
                    offset++
                ) {

                    const value =
                        rows[r + 1][c + offset];

                    if (
                        value !== undefined &&
                        String(value).trim() !== ""
                    ) {

                        return String(value).trim();
                    }
                }
            }
        }
    }


    return "";
}


/* ============================================================
   CSP
============================================================ */

function detectCSPTitle(rows) {

    for (
        let r = 0;
        r < rows.length;
        r++
    ) {

        for (
            let c = 0;
            c < rows[r].length;
            c++
        ) {

            const value =
                normalizeText(
                    rows[r][c]
                );


            if (
                !value.includes(
                    "coordonnees du csp"
                )
            ) {
                continue;
            }


            for (
                let offset = 1;
                offset <= 3;
                offset++
            ) {

                const previous =
                    rows[r - offset];

                if (!previous) {
                    continue;
                }


                if (
                    previous[c] &&
                    String(previous[c]).trim()
                ) {

                    return String(
                        previous[c]
                    ).trim();
                }


                const firstValue =
                    previous.find(value =>
                        String(value ?? "").trim()
                    );


                if (firstValue) {

                    return String(
                        firstValue
                    ).trim();
                }
            }
        }
    }


    return "";
}


/* ============================================================
   TABLE CLIENT
============================================================ */

function findClientHeaderRow(rows) {

    for (
        let i = 0;
        i < rows.length;
        i++
    ) {

        const normalized =
            rows[i].map(
                normalizeText
            );


        const hasSiret =
            normalized.some(
                value =>
                    value.includes("siret")
            );


        const hasRaison =
            normalized.some(
                value =>
                    value.includes(
                        "raison sociale"
                    )
            );


        if (hasSiret && hasRaison) {
            return i;
        }
    }


    return -1;
}


function findColumnIndex(
    headers,
    possibleNames
) {

    const normalizedHeaders =
        headers.map(normalizeText);

    const normalizedNames =
        possibleNames.map(normalizeText);


    /*
        Correspondance exacte.
    */

    for (const name of normalizedNames) {

        const index =
            normalizedHeaders.findIndex(
                header =>
                    header === name
            );

        if (index !== -1) {
            return index;
        }
    }


    /*
        Correspondance partielle.
    */

    for (const name of normalizedNames) {

        const index =
            normalizedHeaders.findIndex(
                header =>
                    header &&
                    (
                        header.includes(name) ||
                        name.includes(header)
                    )
            );

        if (index !== -1) {
            return index;
        }
    }


    return -1;
}


/* ============================================================
   ID LIGNE
============================================================ */

function createLineId(
    siret,
    company,
    rowIndex
) {

    const a =
        cleanSiret(siret)
            .replace(
                /[^a-zA-Z0-9]/g,
                ""
            );


    const b =
        normalizeText(company)
            .replace(
                /[^a-z0-9]/g,
                ""
            )
            .substring(0, 20);


    return (
        "LINE-" +
        (a || b || "ROW") +
        "-" +
        rowIndex
    );
}


/* ============================================================
   TRAITEMENT EXCEL
============================================================ */

function processExcelData(
    rows,
    fileName
) {

    if (
        !rows ||
        rows.length === 0
    ) {

        showToast(
            "Aucune donnée détectée."
        );

        return;
    }


    const source = {

        fileName,

        nomCSP:
            detectCSPTitle(rows),

        contratBAD:
            findValueNearLabel(
                rows,
                [
                    "Contrat BAD",
                    "Contrat B@D"
                ]
            ),

        idtConnexion:
            findValueNearLabel(
                rows,
                [
                    "Idt de connexion",
                    "Identifiant de connexion"
                ]
            ),

        mdpCSP:
            findValueNearLabel(
                rows,
                [
                    "Mdp CSP",
                    "Mot de passe CSP"
                ]
            ),

        numeroAbonneCSP:
            findValueNearLabel(
                rows,
                [
                    "N° Abonné CSP",
                    "N Abonné CSP",
                    "Numero Abonné CSP",
                    "Numéro Abonné CSP"
                ]
            ),

        iban:
            findValueNearLabel(
                rows,
                [
                    "IBAN de prélèvement",
                    "IBAN"
                ]
            ),

        importedAt:
            new Date()
                .toLocaleString("fr-FR")
    };


    const headerIndex =
        findClientHeaderRow(rows);


    if (headerIndex === -1) {

        showToast(
            "Le tableau client n'a pas été détecté."
        );

        return;
    }


    const headers =
        rows[headerIndex];


    const columns = {

        siret:
            findColumnIndex(
                headers,
                [
                    "SIRET du siège social",
                    "SIRET"
                ]
            ),

        raisonSociale:
            findColumnIndex(
                headers,
                [
                    "RAISON SOCIALE",
                    "Raison sociale"
                ]
            ),

        typeFacture:
            findColumnIndex(
                headers,
                [
                    "Factures en émission et/ou réception",
                    "E/R/E+R",
                    "facture type",
                    "Type facture"
                ]
            ),

        numeroAbonne:
            findColumnIndex(
                headers,
                [
                    "N° Abonné e-factures",
                    "N Abonné e-factures",
                    "Numero Abonné e-factures"
                ]
            ),

        identifiant:
            findColumnIndex(
                headers,
                [
                    "Identifiant"
                ]
            ),

        mdp:
            findColumnIndex(
                headers,
                [
                    "Mdp",
                    "Mot de passe"
                ]
            ),

        contratBAD:
            findColumnIndex(
                headers,
                [
                    "Contrat B@D",
                    "Contrat BAD"
                ]
            ),

        rattachement:
            findColumnIndex(
                headers,
                [
                    "Rattachement au contrat CSP",
                    "Rattachement"
                ]
            ),

        dateLimite:
            findColumnIndex(
                headers,
                [
                    "Date limite de traitement",
                    "Date limite"
                ]
            ),

        commentaire:
            findColumnIndex(
                headers,
                [
                    "Commentaire"
                ]
            )
    };


    if (
        columns.siret === -1 ||
        columns.raisonSociale === -1
    ) {

        console.error(
            "Colonnes détectées :",
            columns
        );

        showToast(
            "Colonnes SIRET / Raison sociale introuvables."
        );

        return;
    }


    const importedLines = [];


    for (
        let i = headerIndex + 1;
        i < rows.length;
        i++
    ) {

        const row = rows[i];


        const siret =
            cleanSiret(
                cellValue(
                    row,
                    columns.siret
                )
            );


        const raisonSociale =
            cellValue(
                row,
                columns.raisonSociale
            );


        if (
            !siret &&
            !raisonSociale
        ) {
            continue;
        }


        if (
            normalizeText(siret)
                .includes("siret")
        ) {
            continue;
        }


        importedLines.push({

            id:
                createLineId(
                    siret,
                    raisonSociale,
                    i
                ),

            assignedTo: null,

            selected: false,

            line: {

                siret,

                raisonSociale,

                typeFacture:
                    cellValue(
                        row,
                        columns.typeFacture
                    ),

                numeroAbonne:
                    cellValue(
                        row,
                        columns.numeroAbonne
                    ),

                identifiant:
                    cellValue(
                        row,
                        columns.identifiant
                    ),

                mdp:
                    cellValue(
                        row,
                        columns.mdp
                    ),

                contratBAD:
                    cellValue(
                        row,
                        columns.contratBAD
                    ),

                rattachement:
                    cellValue(
                        row,
                        columns.rattachement
                    ),

                dateLimite:
                    cellValue(
                        row,
                        columns.dateLimite
                    ),

                commentaire:
                    cellValue(
                        row,
                        columns.commentaire
                    )
            }
        });
    }


    if (importedLines.length === 0) {

        showToast(
            "Aucune ligne client détectée."
        );

        return;
    }


    state.source = source;

    state.lines = importedLines;

    state.validated = false;


    saveState();

    renderAll();

    showPage("import");


    showToast(
        `${importedLines.length} ligne(s) importée(s).`
    );
}


